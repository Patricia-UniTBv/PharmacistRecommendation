<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ── BRAND ─────────────────────────────────────────────────────── -->
    <Color x:Key="Primary">#0D2137</Color>
    <Color x:Key="PrimaryDark">#071525</Color>
    <Color x:Key="PrimaryLight">#1A3A5C</Color>
    <Color x:Key="PrimaryContainer">#E8EEF5</Color>
    <Color x:Key="NavyHeader">#0D2137</Color>

    <!-- ── SURFACES ───────────────────────────────────────────────────── -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Background">#F4F7FC</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceVariant">#EEF3FB</Color>

    <!-- ── TEXT ──────────────────────────────────────────────────────── -->
    <Color x:Key="TextPrimary">#1A1F36</Color>
    <Color x:Key="TextSecondary">#64748B</Color>
    <Color x:Key="TextOnPrimary">#FFFFFF</Color>
    <Color x:Key="TextDisabled">#A0AEBF</Color>
    <Color x:Key="TextPlaceholder">#94A3B8</Color>

    <!-- ── BORDERS ────────────────────────────────────────────────────── -->
    <Color x:Key="BorderDefault">#C9D6EA</Color>
    <Color x:Key="BorderStrong">#9BADC8</Color>
    <Color x:Key="Separator">#E8EDF5</Color>

    <!-- ── SEMANTIC ───────────────────────────────────────────────────── -->
    <Color x:Key="Success">#2E7D32</Color>
    <Color x:Key="SuccessLight">#E8F5E9</Color>
    <Color x:Key="Error">#C62828</Color>
    <Color x:Key="ErrorLight">#FFEBEE</Color>
    <Color x:Key="Warning">#E65100</Color>
    <Color x:Key="WarningLight">#FFF3E0</Color>

    <!-- ── LEGACY ALIASES (keep existing views compiling) ────────────── -->
    <Color x:Key="PrimaryDarkText">#E8EEF5</Color>
    <Color x:Key="Secondary">#64748B</Color>
    <Color x:Key="SecondaryDarkText">#94A3B8</Color>
    <Color x:Key="Tertiary">#0D2137</Color>
    <Color x:Key="Black">#1A1F36</Color>
    <Color x:Key="Magenta">#0D2137</Color>
    <Color x:Key="MidnightBlue">#0D2137</Color>
    <Color x:Key="OffBlack">#1A1F36</Color>
    <Color x:Key="Gray100">#F4F7FC</Color>
    <Color x:Key="Gray200">#E8EDF5</Color>
    <Color x:Key="Gray300">#C9D6EA</Color>
    <Color x:Key="Gray400">#9BADC8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray900">#1A1F36</Color>
    <Color x:Key="Gray950">#0D1827</Color>

    <!-- ── BRUSHES ────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="PrimaryBrush"          Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"      Color="{StaticResource PrimaryDark}"/>
    <SolidColorBrush x:Key="NavyHeaderBrush"       Color="{StaticResource NavyHeader}"/>
    <SolidColorBrush x:Key="BackgroundBrush"       Color="{StaticResource Background}"/>
    <SolidColorBrush x:Key="SurfaceBrush"          Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="BorderBrush"           Color="{StaticResource BorderDefault}"/>
    <SolidColorBrush x:Key="SeparatorBrush"        Color="{StaticResource Separator}"/>
    <SolidColorBrush x:Key="SecondaryBrush"        Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush"         Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush"            Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush"            Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush"          Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush"          Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush"          Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush"          Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush"          Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush"          Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush"          Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush"          Color="{StaticResource Gray950}"/>

</ResourceDictionary>
