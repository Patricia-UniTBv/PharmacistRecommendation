<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PharmacistRecommendation.Views.ConflictResolutionView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PharmacistRecommendation.ViewModels"
             x:DataType="viewmodels:ConflictResolutionViewModel"
             BackgroundColor="{StaticResource Background}"
             Title="Rezolvare conflicte import">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource PrimaryContainer}"
                StrokeThickness="0"
                Padding="20,14">
            <VerticalStackLayout Spacing="4">
                <Label Text="Conflicte medicamente"
                       Style="{StaticResource PageTitle}"/>
                <Label Text="Medicamentele introduse manual au conflicte cu datele importate. Alegeți cum doriți să rezolvați fiecare conflict."
                       TextColor="{StaticResource TextSecondary}"
                       FontSize="13"/>
            </VerticalStackLayout>
        </Border>

        <!-- Conflicts list -->
        <ScrollView Grid.Row="1" Padding="12">
            <CollectionView ItemsSource="{Binding Conflicts}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:ConflictViewModel">
                        <Border Stroke="{StaticResource BorderDefault}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource Surface}"
                                Margin="0,0,0,10"
                                Padding="16,12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding MedicationDisplayName}"
                                       FontSize="15"
                                       FontFamily="OpenSansSemiBold"
                                       TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="{Binding ConflictSummary}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"/>

                                <Label Text="Câmpuri în conflict:"
                                       FontFamily="OpenSansSemiBold"
                                       FontSize="13"
                                       TextColor="{StaticResource TextPrimary}"
                                       Margin="0,8,0,4"/>
                                <CollectionView ItemsSource="{Binding ConflictDetails}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:ConflictDetail">
                                            <Grid ColumnDefinitions="*,2*,2*" Padding="4,2">
                                                <Label Grid.Column="0" Text="{Binding FieldName}"
                                                       FontFamily="OpenSansSemiBold"
                                                       TextColor="{StaticResource TextPrimary}"
                                                       FontSize="12"/>
                                                <Label Grid.Column="1" Text="{Binding ExistingValue}"
                                                       TextColor="{StaticResource Error}"
                                                       FontSize="12"/>
                                                <Label Grid.Column="2" Text="{Binding ImportValue}"
                                                       TextColor="{StaticResource Success}"
                                                       FontSize="12"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                                <Label Text="Rezoluție:"
                                       FontFamily="OpenSansSemiBold"
                                       FontSize="13"
                                       TextColor="{StaticResource TextPrimary}"
                                       Margin="0,8,0,4"/>
                                <RadioButton GroupName="{Binding ConflictId}"
                                             Content="Păstrează datele existente (manuale)"
                                             IsChecked="{Binding KeepExisting}"/>
                                <RadioButton GroupName="{Binding ConflictId}"
                                             Content="Actualizează cu datele importate"
                                             IsChecked="{Binding UpdateToImport}"/>
                                <RadioButton GroupName="{Binding ConflictId}"
                                             Content="Ignoră acest medicament"
                                             IsChecked="{Binding SkipMedication}"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <!-- Action buttons -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource PrimaryContainer}"
                StrokeThickness="0"
                Padding="20,12">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="Păstrează tot"
                        Command="{Binding KeepAllExistingCommand}"
                        Style="{StaticResource OutlineButton}"/>
                <Button Grid.Column="1" Text="Actualizează tot"
                        Command="{Binding UpdateAllToImportCommand}"/>
                <Button Grid.Column="2" Text="Aplică selecția"
                        Command="{Binding ApplySelectionsCommand}"/>
            </Grid>
        </Border>

        <ActivityIndicator Grid.RowSpan="3"
                           IsVisible="{Binding IsLoading}"
                           IsRunning="{Binding IsLoading}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
    </Grid>
</ContentPage>
