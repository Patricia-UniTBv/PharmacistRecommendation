<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PharmacistRecommendation.Views.MedicationView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PharmacistRecommendation.ViewModels"
             x:DataType="viewmodels:MedicationViewModel"
             BackgroundColor="{StaticResource Background}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Stroke="{StaticResource BorderDefault}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource NavyHeader}"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0"
                       Text="Lista Medicamente"
                       FontSize="15"
                       FontFamily="OpenSansSemiBold"
                       TextColor="{StaticResource TextOnPrimary}"
                       VerticalOptions="Center"/>

                <Button Grid.Column="1"
                        Text="Adaugă"
                        Command="{Binding AddMedicationCommand}"
                        FontSize="12"
                        HeightRequest="32"
                        Padding="12,4"
                        Margin="4,0"/>

                <Button Grid.Column="2"
                        Text="Import ANM"
                        Command="{Binding ImportCsvCommand}"
                        Style="{StaticResource OutlineButton}"
                        FontSize="12"
                        HeightRequest="32"
                        Padding="12,4"
                        Margin="4,0"
                        TextColor="{StaticResource TextOnPrimary}"
                        BorderColor="{StaticResource TextOnPrimary}"/>

                <Button Grid.Column="3"
                        Text="Import Nomenclator Propriu"
                        Command="{Binding ImportCustomNomenclatorCommand}"
                        Style="{StaticResource OutlineButton}"
                        FontSize="12"
                        HeightRequest="32"
                        Padding="12,4"
                        Margin="4,0"
                        TextColor="{StaticResource TextOnPrimary}"
                        BorderColor="{StaticResource TextOnPrimary}"/>
            </Grid>
        </Border>

        <!-- Search -->
        <Border Grid.Row="1"
                Stroke="{StaticResource BorderDefault}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource Surface}"
                Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0"
                       Text="Nume:"
                       Style="{StaticResource FieldLabel}"
                       VerticalOptions="Center"
                       Margin="0,0,4,0"/>

                <Entry Grid.Column="1"
                       Text="{Binding SearchText}"
                       Placeholder="Caută medicament..."
                       FontSize="12"
                       HeightRequest="32"
                       Margin="2"/>

                <Label Grid.Column="2"
                       Text="Cod:"
                       Style="{StaticResource FieldLabel}"
                       VerticalOptions="Center"
                       Margin="8,0,4,0"/>

                <Entry Grid.Column="3"
                       Text="{Binding SearchCode}"
                       Placeholder="Caută cod..."
                       FontSize="12"
                       HeightRequest="32"
                       Margin="2"/>

                <Picker Grid.Column="4"
                        SelectedIndex="{Binding SelectedFilter}"
                        FontSize="12"
                        HeightRequest="32"
                        WidthRequest="130"
                        Margin="4,2,0,2">
                    <Picker.Items>
                        <x:String>Toate</x:String>
                        <x:String>Active</x:String>
                        <x:String>Inactive</x:String>
                        <x:String>Manual</x:String>
                        <x:String>Nomenclator INM</x:String>
                        <x:String>Nomenclator Propriu</x:String>
                    </Picker.Items>
                </Picker>

                <Button Grid.Column="5"
                        Text="Caută"
                        Command="{Binding SearchCommand}"
                        FontSize="12"
                        HeightRequest="32"
                        Padding="12,4"
                        Margin="4,2,0,2"/>
            </Grid>
        </Border>

        <!-- Data Table -->
        <Grid Grid.Row="2" BackgroundColor="{StaticResource Background}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Table Header -->
            <Border Grid.Row="0"
                    Stroke="{StaticResource BorderDefault}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource PrimaryContainer}">
                <Grid Padding="8,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Text="Cod CIM"
                           FontFamily="OpenSansSemiBold" FontSize="12"
                           TextColor="{StaticResource TextPrimary}"/>
                    <Label Grid.Column="1" Text="Nume"
                           FontFamily="OpenSansSemiBold" FontSize="12"
                           TextColor="{StaticResource TextPrimary}"/>
                    <Label Grid.Column="2" Text="Cod ATC"
                           FontFamily="OpenSansSemiBold" FontSize="12"
                           TextColor="{StaticResource TextPrimary}"/>
                    <Label Grid.Column="3" Text="Status"
                           FontFamily="OpenSansSemiBold" FontSize="12"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center"/>
                    <Label Grid.Column="4" Text="Sursă"
                           FontFamily="OpenSansSemiBold" FontSize="12"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center"/>
                    <Label Grid.Column="5" Text="Acțiuni"
                           FontFamily="OpenSansSemiBold" FontSize="12"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Data List -->
            <CollectionView Grid.Row="1" ItemsSource="{Binding Medications}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:MedicationDisplayItem">
                        <Border Stroke="{StaticResource Separator}"
                                StrokeThickness="1"
                                BackgroundColor="{StaticResource Surface}"
                                Margin="0,1">
                            <Grid Padding="8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0"
                                       Text="{Binding CodCIM}"
                                       FontSize="11"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center"/>

                                <StackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Denumire}"
                                           FontSize="11"
                                           TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="{Binding DCI}"
                                           FontSize="10"
                                           TextColor="{StaticResource TextSecondary}"
                                           Margin="0,2,0,0"/>
                                </StackLayout>

                                <Label Grid.Column="2"
                                       Text="{Binding CodATC}"
                                       FontSize="11"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center"/>

                                <!-- Clickable Status -->
                                <Button Grid.Column="3"
                                        Text="{Binding StatusText}"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        TextColor="{Binding StatusColor}"
                                        BackgroundColor="Transparent"
                                        BorderColor="Transparent"
                                        Command="{Binding ToggleStatusCommand}"
                                        CommandParameter="{Binding .}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        Padding="4,2"/>

                                <!-- Source Display -->
                                <Label Grid.Column="4"
                                       Text="{Binding SourceText}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{Binding SourceColor}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>

                                <StackLayout Grid.Column="5"
                                             Orientation="Horizontal"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center">
                                    <Button Text="Editează"
                                            FontSize="10"
                                            HeightRequest="28"
                                            Padding="8,2"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MedicationViewModel}}, Path=EditMedicationCommand}"
                                            CommandParameter="{Binding .}"
                                            Margin="2,0"/>
                                    <Button Text="Șterge"
                                            FontSize="10"
                                            HeightRequest="28"
                                            Padding="8,2"
                                            Style="{StaticResource DangerButton}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MedicationViewModel}}, Path=DeleteMedicationCommand}"
                                            CommandParameter="{Binding .}"
                                            Margin="2,0"/>
                                </StackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Loading Indicator -->
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              BackgroundColor="#80FFFFFF"
              IsVisible="{Binding IsLoading}">
            <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   WidthRequest="40"
                                   HeightRequest="40"/>
                <Label Text="Se încarcă..."
                       Style="{StaticResource CaptionLabel}"
                       HorizontalOptions="Center"
                       Margin="0,8,0,0"/>
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>
