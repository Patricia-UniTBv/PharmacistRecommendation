<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PharmacistRecommendation.Views.ImportConfigurationView"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <Grid Margin="24,40,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackLayout Grid.Row="0" Spacing="8" Margin="0,0,0,32">
                <Label Text="Configurare importuri"
                       Style="{StaticResource Headline}"
                       HorizontalOptions="Start"
                       HorizontalTextAlignment="Start"/>
                <BoxView HeightRequest="3"
                         WidthRequest="60"
                         BackgroundColor="{StaticResource Primary}"
                         HorizontalOptions="Start"/>
                <Label Text="Configurează căile pentru importul documentelor"
                       Style="{StaticResource SubHeadline}"
                       HorizontalOptions="Start"
                       HorizontalTextAlignment="Start"
                       Margin="0,8,0,0"/>
            </StackLayout>

            <StackLayout Grid.Row="1" Spacing="24">

                <Border BackgroundColor="{StaticResource Surface}"
                        StrokeThickness="0"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource BorderDefault}" Offset="0,2" Radius="8" Opacity="0.15"/>
                    </Border.Shadow>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <StackLayout Spacing="12">
                        <Label Text="Director rețete"
                               Style="{StaticResource SectionTitle}"/>

                        <Label Text="Specifică calea către directorul care conține rețetele"
                               Style="{StaticResource CaptionLabel}"
                               Margin="0,0,0,8"/>

                        <Border BackgroundColor="{StaticResource SurfaceVariant}"
                                StrokeThickness="1"
                                Stroke="{StaticResource BorderDefault}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Entry Text="{Binding PrescriptionPath, Mode=TwoWay}"
                                   Placeholder="Exemplu: C:\Documents\Retete"
                                   BackgroundColor="Transparent"
                                   Margin="12,0"/>
                        </Border>
                    </StackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource Surface}"
                        StrokeThickness="0"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource BorderDefault}" Offset="0,2" Radius="8" Opacity="0.15"/>
                    </Border.Shadow>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <StackLayout Spacing="12">
                        <Label Text="Director bonuri"
                               Style="{StaticResource SectionTitle}"/>

                        <Label Text="Specifică calea către directorul care conține bonurile"
                               Style="{StaticResource CaptionLabel}"
                               Margin="0,0,0,8"/>

                        <Border BackgroundColor="{StaticResource SurfaceVariant}"
                                StrokeThickness="1"
                                Stroke="{StaticResource BorderDefault}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Entry Text="{Binding ReceiptPath, Mode=TwoWay}"
                                   Placeholder="Exemplu: C:\Documents\Bonuri"
                                   BackgroundColor="Transparent"
                                   Margin="12,0"/>
                        </Border>
                    </StackLayout>
                </Border>

                <Button Text="Salvează configurația"
                        Command="{Binding SaveCommand}"
                        Padding="20,12"
                        WidthRequest="180"
                        HorizontalOptions="Start"
                        Margin="0,16,0,0"/>

            </StackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
