<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:PharmacistRecommendation.Helpers"
    x:Class="PharmacistRecommendation.Views.CardConfigurationView"
    Padding="24,20,24,24"
    BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">

        <StackLayout Grid.Row="0" Spacing="4">
            <Label Text="Adăugare card pacient"
                   Style="{StaticResource Headline}"
                   Margin="0,8,0,4"/>
            <BoxView HeightRequest="2"
                     WidthRequest="60"
                     BackgroundColor="{StaticResource Primary}"
                     HorizontalOptions="Center"
                     CornerRadius="1"/>
        </StackLayout>

        <Border Grid.Row="1"
                Stroke="{StaticResource BorderDefault}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                BackgroundColor="{StaticResource Surface}"
                Padding="24"
                Shadow="{OnPlatform Default='0,2,8,0,#10000000', iOS='0,1,4,0,#15000000'}">
            <ScrollView>
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="20"
                      ColumnSpacing="28">

                    <StackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                        <Label Text="Număr card" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource Surface}">
                            <Entry Placeholder="Introduceți nr. card"
                                   Text="{Binding CardNumber}"
                                   BackgroundColor="Transparent"
                                   Margin="12,8">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </StackLayout>

                    <StackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                        <Label Text="Nume pacient" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource Surface}">
                            <Entry Placeholder="Nume de familie"
                                   Text="{Binding LastName}"
                                   BackgroundColor="Transparent"
                                   Margin="12,8">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </StackLayout>

                    <StackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                        <Label Text="Prenume pacient" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource Surface}">
                            <Entry Placeholder="Prenume"
                                   Text="{Binding FirstName}"
                                   BackgroundColor="Transparent"
                                   Margin="12,8">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </StackLayout>

                    <StackLayout Grid.Row="1" Grid.Column="0" Spacing="6">
                        <Label Text="CNP" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource Surface}">
                            <Entry Placeholder="Cod numeric personal"
                                   Text="{Binding Cnp}"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"
                                   Margin="12,8">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </StackLayout>

                    <StackLayout Grid.Row="2" Grid.Column="0" Spacing="6">
                        <Label Text="CID (opțional)" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource Surface}">
                            <Entry Placeholder="Card identifier (opțional)"
                                   Text="{Binding Cid}"
                                   IsReadOnly="False"
                                   BackgroundColor="Transparent"
                                   Margin="12,8">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </StackLayout>

                    <StackLayout Grid.Row="2" Grid.Column="1" Spacing="6">
                        <Label Text="Telefon" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource Surface}">
                            <Entry Placeholder="Număr de telefon"
                                   Text="{Binding Phone}"
                                   Keyboard="Telephone"
                                   BackgroundColor="Transparent"
                                   Margin="12,8">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </StackLayout>

                    <StackLayout Grid.Row="3" Grid.Column="0" Spacing="6">
                        <Label Text="Email" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource Surface}">
                            <Entry Placeholder="Adresă de email"
                                   Text="{Binding Email}"
                                   Keyboard="Email"
                                   BackgroundColor="Transparent"
                                   Margin="12,8">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </StackLayout>

                    <StackLayout Grid.Row="3" Grid.Column="1" Spacing="6">
                        <Label Text="Data nașterii" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource Surface}">
                            <Entry Text="{Binding BirthdateString}"
                                   Placeholder="dd/mm/yyyy"
                                   BackgroundColor="Transparent"
                                   Margin="12,8">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </StackLayout>

                    <StackLayout Grid.Row="4" Grid.Column="0" Spacing="6">
                        <Label Text="Gen" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource Surface}">
                            <Picker SelectedItem="{Binding Gender}"
                                    BackgroundColor="Transparent"
                                    Margin="12,8">
                                <Picker.Items>
                                    <x:String>Feminin</x:String>
                                    <x:String>Masculin</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                    </StackLayout>

                </Grid>
            </ScrollView>
        </Border>

        <HorizontalStackLayout Grid.Row="2"
                               Spacing="16"
                               HorizontalOptions="Center"
                               Margin="0,8,0,0">

            <Button Text="Resetează"
                    Command="{Binding NewCardCommand}"
                    Style="{StaticResource OutlineButton}"/>

            <Button Text="Tipărește"
                    Command="{Binding PrintCommand}"/>

            <Button Text="Salvează"
                    Command="{Binding SaveCommand}"/>

            <Label Text="{Binding ValidationMessage}"
                   TextColor="{StaticResource TextPrimary}"
                   FontAttributes="Italic"
                   Margin="0,10,0,0"/>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>
