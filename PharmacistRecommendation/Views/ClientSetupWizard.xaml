<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:PharmacistRecommendation.ViewModels"
    xmlns:helpers="clr-namespace:PharmacistRecommendation.Helpers"
    x:Class="PharmacistRecommendation.Views.ClientSetupWizard"
    x:DataType="viewmodels:ClientSetupWizardViewModel"
    Title="Configurare Client"
    BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <Grid Padding="40,60,40,40"
              RowDefinitions="Auto,*,Auto"
              RowSpacing="32"
              MaximumWidthRequest="700"
              HorizontalOptions="Center">

            <!-- Header Section -->
            <StackLayout Grid.Row="0" Spacing="16">
                <Label Text="Bine ați venit!"
                       Style="{StaticResource Headline}"/>
                <Label Text="Configurare Client Farmacie"
                       Style="{StaticResource SubHeadline}"/>
                <BoxView HeightRequest="3"
                         WidthRequest="60"
                         BackgroundColor="{StaticResource Primary}"
                         HorizontalOptions="Center"
                         CornerRadius="2"
                         Margin="0,8,0,0"/>
            </StackLayout>

            <!-- Main Content Section -->
            <Border Grid.Row="1"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource Surface}"
                    Padding="40">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource BorderDefault}" Offset="0,2" Radius="8" Opacity="0.15"/>
                </Border.Shadow>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="24">

                    <StackLayout Spacing="12">
                        <Label Text="Conectare la Serverul Farmaciei"
                               FontFamily="OpenSansSemiBold"
                               FontSize="18"
                               TextColor="{StaticResource Primary}"/>
                        <Label FontSize="15"
                               TextColor="{StaticResource TextPrimary}"
                               LineHeight="1.5">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Pentru a conecta acest client la serverul farmaciei, vă rugăm să introduceți informațiile de mai jos.&#x0a;&#x0a;" />
                                    <Span Text="Aceste informații sunt furnizate de administratorul serverului." FontAttributes="Italic" TextColor="{StaticResource TextSecondary}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </StackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}"/>

                    <!-- Input Fields -->
                    <StackLayout Spacing="20">

                        <!-- Server Address Field -->
                        <StackLayout Spacing="8">
                            <Label Text="Adresa Server" Style="{StaticResource FieldLabel}"/>
                            <Label Text="Exemplu: 192.168.1.100 sau PHARMACY-SERVER"
                                   Style="{StaticResource CaptionLabel}"
                                   Margin="0,0,0,4"/>
                            <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="12,0" HeightRequest="40">
                                <Entry Text="{Binding ServerAddress}"
                                       Placeholder="Introduceți adresa serverului"
                                       BackgroundColor="Transparent"
                                       VerticalOptions="Center">
                                    <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                </Entry>
                            </Border>
                        </StackLayout>

                        <!-- Password Field -->
                        <StackLayout Spacing="8">
                            <Label Text="Parolă pentru utilizator appuser" Style="{StaticResource FieldLabel}"/>
                            <Label Text="Parola SQL pentru utilizatorul appuser"
                                   Style="{StaticResource CaptionLabel}"
                                   Margin="0,0,0,4"/>
                            <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="12,0" HeightRequest="40">
                                <Entry Text="{Binding AppUserPassword}"
                                       Placeholder="Introduceți parola"
                                       IsPassword="True"
                                       BackgroundColor="Transparent"
                                       VerticalOptions="Center">
                                    <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                </Entry>
                            </Border>
                        </StackLayout>

                    </StackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}"/>

                    <!-- Test Connection Button -->
                    <Button Text="Testează Conexiunea"
                            FontSize="16"
                            FontAttributes="Bold"
                            Command="{Binding TestConnectionCommand}"
                            HeightRequest="52"
                            IsEnabled="{Binding IsTesting, Converter={StaticResource InvertedBoolConverter}}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsTesting}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLight}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- Progress Section -->
                    <StackLayout Spacing="16" IsVisible="{Binding IsTesting}">
                        <ActivityIndicator IsRunning="{Binding IsTesting}"
                                           HeightRequest="40" WidthRequest="40"
                                           HorizontalOptions="Center"/>
                        <Label Text="{Binding ProgressMessage}"
                               FontSize="14"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center"
                               FontAttributes="Italic"/>
                    </StackLayout>

                    <!-- Status Message Section -->
                    <Border IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
                            Padding="20"
                            StrokeShape="RoundRectangle 12"
                            Margin="0,8,0,0">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding HasError}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource ErrorLight}"/>
                                <Setter Property="Stroke" Value="{StaticResource Error}"/>
                                <Setter Property="StrokeThickness" Value="2"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsConnectionSuccessful}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource SuccessLight}"/>
                                <Setter Property="Stroke" Value="{StaticResource Success}"/>
                                <Setter Property="StrokeThickness" Value="2"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding StatusMessage}" FontSize="14" LineHeight="1.6">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding HasError}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource Error}"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsConnectionSuccessful}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource Success}"/>
                                    <Setter Property="FontAttributes" Value="Bold"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- Action Buttons -->
            <HorizontalStackLayout Grid.Row="2"
                                   Spacing="16"
                                   HorizontalOptions="Center"
                                   Margin="0,16,0,0">

                <Button Text="Anulare"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource OutlineButton}"
                        WidthRequest="140"
                        HeightRequest="48"
                        IsVisible="{Binding IsConnectionSuccessful, Converter={StaticResource InvertedBoolConverter}}"
                        IsEnabled="{Binding IsTesting, Converter={StaticResource InvertedBoolConverter}}"/>

                <Button Text="Finalizare"
                        FontAttributes="Bold"
                        Command="{Binding FinishCommand}"
                        WidthRequest="140"
                        HeightRequest="48"
                        IsVisible="{Binding IsConnectionSuccessful}"/>

            </HorizontalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>
