<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PharmacistRecommendation.Views.ServerConfigurationView"
             xmlns:vm="clr-namespace:PharmacistRecommendation.ViewModels"
             x:DataType="vm:ServerConfigurationViewModel"
             Title="Configurare Conexiune Server"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <Label Text="Configurare Conexiune la Server"
                   Style="{StaticResource Headline}"
                   Margin="0,0,0,20"/>

            <!-- Mode Info -->
            <Border Stroke="{StaticResource BorderDefault}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{StaticResource SurfaceVariant}"
                    Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding ModeDescription}"
                           FontSize="14"
                           TextColor="{StaticResource TextPrimary}"/>
                    <Label Text="{Binding ModeInfo}"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Server IP Address -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Adresă IP Server (sau nume computer):"
                       Style="{StaticResource SectionTitle}"/>
                <Label Text="Ex: 192.168.1.100 sau SERVERPC"
                       Style="{StaticResource CaptionLabel}"/>
                <Entry Text="{Binding ServerAddress}"
                       Placeholder="Introduceți adresa IP sau numele serverului"/>
            </VerticalStackLayout>

            <!-- Database Name -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Nume Bază de Date:" Style="{StaticResource SectionTitle}"/>
                <Entry Text="{Binding DatabaseName}"
                       Placeholder="PharmacistRecommendationDB"/>
            </VerticalStackLayout>

            <!-- SQL Server Instance -->
            <VerticalStackLayout Spacing="5" IsVisible="{Binding ShowInstanceName}">
                <Label Text="Instanță SQL Server:" Style="{StaticResource SectionTitle}"/>
                <Label Text="Lăsați gol pentru instanța implicită sau specificați (ex: PHARMACYREC)"
                       Style="{StaticResource CaptionLabel}"/>
                <Entry Text="{Binding InstanceName}"
                       Placeholder="PHARMACYREC"/>
            </VerticalStackLayout>

            <!-- Username (for Client mode) -->
            <VerticalStackLayout Spacing="5" IsVisible="{Binding IsClientMode}">
                <Label Text="Utilizator SQL:" Style="{StaticResource SectionTitle}"/>
                <Entry Text="{Binding Username}" Placeholder="appuser"/>
            </VerticalStackLayout>

            <!-- Password (for Client mode) -->
            <VerticalStackLayout Spacing="5" IsVisible="{Binding IsClientMode}">
                <Label Text="Parolă:" Style="{StaticResource SectionTitle}"/>
                <Entry Text="{Binding Password}"
                       IsPassword="True"
                       Placeholder="Introduceți parola"/>
            </VerticalStackLayout>

            <!-- Test Connection Button -->
            <Button Text="Testează Conexiunea"
                    Command="{Binding TestConnectionCommand}"
                    HeightRequest="46"
                    Margin="0,10,0,0"/>

            <!-- Save Button -->
            <Button Text="Salvează Configurarea"
                    Command="{Binding SaveCommand}"
                    HeightRequest="46"/>

            <!-- Status Message -->
            <Label Text="{Binding StatusMessage}"
                   TextColor="{Binding StatusColor}"
                   HorizontalOptions="Center"
                   IsVisible="{Binding HasStatusMessage}"
                   Margin="0,10,0,0"/>

            <!-- Help Section -->
            <Border Stroke="{StaticResource BorderDefault}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{StaticResource SurfaceVariant}"
                    Padding="15"
                    Margin="0,20,0,0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Ajutor:"
                           Style="{StaticResource SectionTitle}"/>
                    <Label FontSize="12" TextColor="{StaticResource TextSecondary}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Pentru a găsi adresa IP a serverului, rulați "/>
                                <Span Text="ipconfig" FontAttributes="Bold"/>
                                <Span Text=" în Command Prompt pe computerul server."/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="Asigurați-vă că SQL Server acceptă conexiuni la distanță și că firewall-ul permite conexiunea pe portul 1433."
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"/>
                    <Label Text="Numele de utilizator implicit este 'appuser' - acest utilizator trebuie creat în SQL Server de către administrator."
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"
                           IsVisible="{Binding IsClientMode}"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
