<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PharmacistRecommendation.Views.ServerConfigurationView"
             xmlns:vm="clr-namespace:PharmacistRecommendation.ViewModels"
             x:DataType="vm:ServerConfigurationViewModel"
             Title="Configurare Conexiune Server"
             BackgroundColor="White">
    
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">
            
            <!-- Title -->
            <Label Text="Configurare Conexiune la Server"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <!-- Mode Info -->
            <Frame BorderColor="LightGray" 
                   CornerRadius="8" 
                   Padding="15"
                   BackgroundColor="#F0F0F0">
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding ModeDescription}"
                           FontSize="14"
                           TextColor="#333333"/>
                    <Label Text="{Binding ModeInfo}"
                           FontSize="12"
                           TextColor="#666666"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Server IP Address -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Adresa IP Server (sau nume computer):" 
                       FontSize="16"
                       FontAttributes="Bold"/>
                <Label Text="Ex: 192.168.1.100 sau SERVERPC"
                       FontSize="12"
                       TextColor="Gray"/>
                <Entry Text="{Binding ServerAddress}"
                       Placeholder="Introduce?i adresa IP sau numele serverului"
                       FontSize="14"/>
            </VerticalStackLayout>

            <!-- Database Name -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Nume Baz? de Date:" 
                       FontSize="16"
                       FontAttributes="Bold"/>
                <Entry Text="{Binding DatabaseName}"
                       Placeholder="PharmacistRecommendationDB"
                       FontSize="14"/>
            </VerticalStackLayout>

            <!-- SQL Server Instance -->
            <VerticalStackLayout Spacing="5" IsVisible="{Binding ShowInstanceName}">
                <Label Text="Instan?? SQL Server:" 
                       FontSize="16"
                       FontAttributes="Bold"/>
                <Label Text="L?sa?i gol pentru instan?a implicit? sau specifica?i (ex: SQLEXPRESS)"
                       FontSize="12"
                       TextColor="Gray"/>
                <Entry Text="{Binding InstanceName}"
                       Placeholder="SQLEXPRESS"
                       FontSize="14"/>
            </VerticalStackLayout>

            <!-- Username (for Client mode) -->
            <VerticalStackLayout Spacing="5" IsVisible="{Binding IsClientMode}">
                <Label Text="Utilizator SQL:" 
                       FontSize="16"
                       FontAttributes="Bold"/>
                <Entry Text="{Binding Username}"
                       Placeholder="appuser"
                       FontSize="14"/>
            </VerticalStackLayout>

            <!-- Password (for Client mode) -->
            <VerticalStackLayout Spacing="5" IsVisible="{Binding IsClientMode}">
                <Label Text="Parol?:" 
                       FontSize="16"
                       FontAttributes="Bold"/>
                <Entry Text="{Binding Password}"
                       IsPassword="True"
                       Placeholder="Introduce?i parola"
                       FontSize="14"/>
            </VerticalStackLayout>

            <!-- Test Connection Button -->
            <Button Text="Testeaz? Conexiunea"
                    Command="{Binding TestConnectionCommand}"
                    BackgroundColor="#007ACC"
                    TextColor="White"
                    FontSize="16"
                    HeightRequest="50"
                    CornerRadius="8"
                    Margin="0,10,0,0"/>

            <!-- Save Button -->
            <Button Text="Salveaz? Configurarea"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#28A745"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="8"/>

            <!-- Status Message -->
            <Label Text="{Binding StatusMessage}"
                   FontSize="14"
                   TextColor="{Binding StatusColor}"
                   HorizontalOptions="Center"
                   IsVisible="{Binding HasStatusMessage}"
                   Margin="0,10,0,0"/>

            <!-- Help Section -->
            <Frame BorderColor="LightBlue" 
                   CornerRadius="8" 
                   Padding="15"
                   BackgroundColor="#E3F2FD"
                   Margin="0,20,0,0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Ajutor:"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1976D2"/>
                    <Label FontSize="12" TextColor="#333333">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text=" Pentru a g?si adresa IP a serverului, rula?i "/>
                                <Span Text="ipconfig" FontAttributes="Bold"/>
                                <Span Text=" n Command Prompt pe computerul server."/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text=" Asigura?i-v? c? SQL Server accept? conexiuni la distan?? ?i c? firewall-ul permite conexiunea pe portul 1433."
                           FontSize="12"
                           TextColor="#333333"/>
                    <Label Text=" Numele de utilizator implicit este 'appuser' - acest utilizator trebuie creat n SQL Server de c?tre administrator."
                           FontSize="12"
                           TextColor="#333333"
                           IsVisible="{Binding IsClientMode}"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
