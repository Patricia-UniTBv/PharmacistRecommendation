<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PharmacistRecommendation.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PharmacistRecommendation.ViewModels"
             xmlns:models="clr-namespace:Entities.Models;assembly=Entities"
             xmlns:helpers="clr-namespace:PharmacistRecommendation.Helpers"
             x:DataType="viewmodels:ReportsViewModel">

    <ScrollView>
        <StackLayout Padding="20" Spacing="20">

            <Label Text="Centru Rapoarte" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center"/>

            <Frame BackgroundColor="{StaticResource SurfaceVariant}" Padding="15" HasShadow="False">
                <StackLayout Spacing="10">
                    <Label Text="Perioada raport:" FontAttributes="Bold"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <StackLayout Grid.Column="0">
                            <Label Text="Data inceput:"/>
                            <DatePicker Date="{Binding StartDate}" Format="dd.MM.yyyy"/>
                        </StackLayout>

                        <StackLayout Grid.Column="1">
                            <Label Text="Data final:"/>
                            <DatePicker Date="{Binding EndDate}" Format="dd.MM.yyyy"/>
                        </StackLayout>
                    </Grid>

                    <StackLayout>
                        <Label Text="Filtru pacient (optional):"/>
                        <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="10,0" HeightRequest="38">
                            <Entry Text="{Binding PatientFilter}"
                                   Placeholder="Nume, CNP sau nr. card"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </StackLayout>

                    <Grid ColumnDefinitions="180,180" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="Resetare filtre"
                                Command="{Binding ResetFiltersCommand}"
                                Style="{StaticResource OutlineButton}"/>

                        <Button Grid.Column="1"
                                Text="Actualizare date"
                                Command="{Binding RefreshDataCommand}"/>
                    </Grid>
                </StackLayout>
            </Frame>

            <Label Text="Tipuri Rapoarte:" 
                   FontSize="18" 
                   FontAttributes="Bold"/>

            <CollectionView ItemsSource="{Binding ReportTypes}"
                           SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:ReportTypeModel">
                        <Grid Padding="0,5">
                            <Frame BackgroundColor="{StaticResource Surface}" 
                                   HasShadow="True" 
                                   Padding="15"
                                   CornerRadius="10">
                                <Grid ColumnDefinitions="*,120" ColumnSpacing="15">

                                    <!--<Label Grid.Column="0" 
                                           Text="{Binding Icon}" 
                                           FontSize="24"
                                           VerticalOptions="Center"/>-->

                                    <StackLayout Grid.Column="0">
                                        <Label Text="{Binding Title}" 
                                               FontAttributes="Bold" 
                                               FontSize="16"/>
                                        <Label Text="{Binding Description}" 
                                               FontSize="12" 
                                               TextColor="{StaticResource TextSecondary}"/>
                                    </StackLayout>

                                    <Button Grid.Column="2" 
                                            Text="Incarcare date"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ReportsViewModel}}, Path=SelectReportTypeCommand}"
                                            CommandParameter="{Binding .}"
                                            FontSize="12"
                                            VerticalOptions="Center"/>
                                </Grid>
                            </Frame>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsVisible="{Binding IsLoadingData}" 
                              IsRunning="{Binding IsLoadingData}"
                              />

            <Label Text="Se incarca datele..." 
                   IsVisible="{Binding IsLoadingData}"
                   HorizontalOptions="Center"
                   FontAttributes="Italic"/>

            <Frame IsVisible="{Binding SelectedReportType, Converter={StaticResource NotNullToBoolConverter}}"
                   BackgroundColor="{StaticResource Surface}" 
                   HasShadow="True" 
                   Padding="15">
                <StackLayout Spacing="15">

                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Label Text="{Binding CurrentReportTitle}" 
                               FontSize="20" 
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalOptions="StartAndExpand"/>

                        <!--<Button Text="Salveaz PDF"
                                Command="{Binding SaveAsPdfCommand}"
                                BackgroundColor="#E74C3C"
                                TextColor="White"
                                FontSize="14"
                                IsVisible="{Binding HasData}"
                                VerticalOptions="Center"/>-->
                    </StackLayout>

                    <Label Text="{Binding DataCount}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"/>

                    <Frame IsVisible="{Binding IsPrescriptionReport}"
       BackgroundColor="{StaticResource SurfaceVariant}"
       Padding="10">
                        <StackLayout>
                            <Label Text="Date gasite:" FontAttributes="Bold" Margin="0,0,0,10"/>

                            <CollectionView x:Name="PrescriptionCollectionView"
                        ItemsSource="{Binding PrescriptionsData}"
                       
                        SelectionMode="Single"
                        HeightRequest="400"
                        ItemSizingStrategy="MeasureFirstItem">

                                <!-- HEADER -->
                                <CollectionView.Header>
                                    <Grid Padding="5"
                      ColumnDefinitions="120,*,180,180,100,180"
                      ColumnSpacing="10"
                      BackgroundColor="{StaticResource NavyHeader}">
                                        <Label Grid.Column="0"
                           Text="Data"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                                        <Label Grid.Column="1"
                           Text="Pacient"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalTextAlignment="Center"/>
                                        <Label Grid.Column="2"
                           Text="CNP"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                                        <Label Grid.Column="3"
                           Text="Card"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                                        <Label Grid.Column="4"
                           Text="Serie/Nr"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                                        <Label Grid.Column="5"
                           Text="Acțiuni"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                                    </Grid>
                                </CollectionView.Header>

                                <!-- ITEM -->
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Prescription">
                                        <Grid Padding="5"
                          ColumnDefinitions="120,*,180,180,100,180"
                          ColumnSpacing="10"
                          HeightRequest="38">

                                            <!-- DATA -->
                                            <Frame Grid.Column="0"
                               BackgroundColor="{StaticResource Surface}"
                               Padding="5"
                               CornerRadius="5"
                               HasShadow="False"
                               VerticalOptions="Fill">
                                                <Label Text="{Binding IssueDate, StringFormat='{0:dd.MM.yyyy}'}"
                                   FontSize="12"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center"
                                   VerticalTextAlignment="Center"/>
                                            </Frame>

                                            <!-- PACIENT -->
                                            <Frame Grid.Column="1"
                               BackgroundColor="{StaticResource Surface}"
                               Padding="5"
                               CornerRadius="5"
                               HasShadow="False"
                               VerticalOptions="Fill">
                                                <Label Text="{Binding PatientName}"
                                   FontSize="12"
                                   VerticalOptions="Center"
                                   VerticalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"/>
                                            </Frame>

                                            <!-- CNP -->
                                            <Frame Grid.Column="2"
                               BackgroundColor="{StaticResource Surface}"
                               Padding="5"
                               CornerRadius="5"
                               HasShadow="False"
                               VerticalOptions="Fill">
                                                <Label Text="{Binding PatientCnp}"
                                   FontSize="12"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center"
                                   VerticalTextAlignment="Center"/>
                                            </Frame>

                                            <!-- CARD -->
                                            <Frame Grid.Column="3"
                               BackgroundColor="{StaticResource Surface}"
                               Padding="5"
                               CornerRadius="5"
                               HasShadow="False"
                               VerticalOptions="Fill">
                                                <Label FontSize="12"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center"
                                   VerticalTextAlignment="Center">
                                                    <Label.Text>
                                                        <Binding Path="CardNumber" TargetNullValue="—" FallbackValue="—" />
                                                    </Label.Text>
                                                </Label>
                                            </Frame>

                                            <!-- SERIE/NR -->
                                            <Frame Grid.Column="4"
                               BackgroundColor="{StaticResource Surface}"
                               Padding="5"
                               CornerRadius="5"
                               HasShadow="False"
                               VerticalOptions="Fill">
                                                <Label FontSize="12"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center"
                                   VerticalTextAlignment="Center">
                                                    <Label.Text>
                                                        <MultiBinding StringFormat="{}{0}/{1}">
                                                            <Binding Path="Series"/>
                                                            <Binding Path="Number"/>
                                                        </MultiBinding>
                                                    </Label.Text>
                                                </Label>
                                            </Frame>

                                            <Grid Grid.Column="5" ColumnDefinitions="*,*" ColumnSpacing="5" HeightRequest="30" VerticalOptions="Center">
                                                <Button Text="Vizualizare"
                                                         Grid.Column="0"
                                                         FontSize="12"
                                                         CornerRadius="5"
                                                         VerticalOptions="Fill"
                                                         HorizontalOptions="Fill"
                                                         Padding="0,1,0,14"
                                    Command="{Binding Source={x:Reference PrescriptionCollectionView}, Path=BindingContext.OpenPrescriptionCommand}"
                                    CommandParameter="{Binding .}"/>
                                                
                                                <Button Text="Șterge"
                                                         Grid.Column="1"
                                                         FontSize="12"
                                                         Style="{StaticResource DangerButton}"
                                                         CornerRadius="5"
                                                         VerticalOptions="Fill"
                                                         HorizontalOptions="Fill"
                                                         Padding="0,1,0,14"
                                    Command="{Binding Source={x:Reference PrescriptionCollectionView}, Path=BindingContext.DeletePrescriptionCommand}"
                                    CommandParameter="{Binding .}"/>
                                            </Grid>

                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>

                            </CollectionView>
                        </StackLayout>
                    </Frame>


                    <Frame IsVisible="{Binding IsMonitoringReport}"
       BackgroundColor="{StaticResource SurfaceVariant}"
       Padding="10">

                        <StackLayout>

                            <Label Text="Monitorizări găsite:"
               FontAttributes="Bold"
               Margin="0,0,0,7"/>

                            <CollectionView ItemsSource="{Binding MonitoringData}"
                        SelectedItem="{Binding SelectedMonitoring}"
                        x:Name="CollectionViewReference"
                        SelectionMode="Single"
                        HeightRequest="400"
                        ItemSizingStrategy="MeasureFirstItem">

                                <!-- HEADER -->
                                <CollectionView.Header>
                                    <Grid Padding="5"
                      ColumnDefinitions="120,*,180,180,180,180"
                      ColumnSpacing="10"
                      BackgroundColor="{StaticResource NavyHeader}">

                                        <Label Text="Data"
                           TextColor="White"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                                        <Label Grid.Column="1"
                           Text="Pacient"
                           TextColor="White"
                           FontAttributes="Bold"
                           VerticalTextAlignment="Center"/>
                                        <Label Grid.Column="2"
                           Text="CNP"
                           TextColor="White"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                                        <Label Grid.Column="3"
                           Text="CID"
                           TextColor="White"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                                        <Label Grid.Column="4"
                           Text="Card"
                           TextColor="White"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                                        <Label Grid.Column="5"
                           Text=""
                           TextColor="White"/>
                                    </Grid>
                                </CollectionView.Header>

                                <!-- ITEM -->
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Monitoring">

                                        <Grid Padding="5"
                          HeightRequest="38"
                          ColumnDefinitions="120,*,180,180,180,180"
                          ColumnSpacing="10">

                                            <!-- DATA -->
                                            <Frame Grid.Column="0"
                               BackgroundColor="{StaticResource Surface}"
                               Padding="5"
                               CornerRadius="5"
                               HasShadow="False"
                               VerticalOptions="Fill">
                                                <Label Text="{Binding MonitoringDate, StringFormat='{0:dd.MM.yyyy}'}"
                                   FontSize="12"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center"
                                   VerticalTextAlignment="Center"/>
                                            </Frame>

                                            <!-- PACIENT -->
                                            <Frame Grid.Column="1"
                               BackgroundColor="{StaticResource Surface}"
                               Padding="5"
                               CornerRadius="5"
                               HasShadow="False"
                               VerticalOptions="Fill">
                                                <Label FontSize="12"
                                   VerticalOptions="Center"
                                   VerticalTextAlignment="Center"
                                   LineBreakMode="TailTruncation">
                                                    <Label.Text>
                                                        <MultiBinding StringFormat="{}{0} {1}">
                                                            <Binding Path="Patient.LastName"/>
                                                            <Binding Path="Patient.FirstName"/>
                                                        </MultiBinding>
                                                    </Label.Text>
                                                </Label>
                                            </Frame>

                                            <!-- CNP -->
                                            <Frame Grid.Column="2"
                               BackgroundColor="{StaticResource Surface}"
                               Padding="5"
                               CornerRadius="5"
                               HasShadow="False"
                               VerticalOptions="Fill">
                                                <Label Text="{Binding Patient.Cnp}"
                                   FontSize="12"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center"
                                   VerticalTextAlignment="Center"/>
                                            </Frame>

                                            <!-- CID -->
                                            <Frame Grid.Column="3"
                               BackgroundColor="{StaticResource Surface}"
                               Padding="5"
                               CornerRadius="5"
                               HasShadow="False"
                               VerticalOptions="Fill">
                                                <Label Text="{Binding Patient.Cid}"
                                   FontSize="12"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center"
                                   VerticalTextAlignment="Center"/>
                                            </Frame>
                                            

                                            <!-- CARD -->
                                            <Frame Grid.Column="4"
                               BackgroundColor="{StaticResource Surface}"
                               Padding="5"
                               CornerRadius="5"
                               HasShadow="False"
                               VerticalOptions="Fill">
                                                <Label FontSize="12"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center"
                                   VerticalTextAlignment="Center">
                                                    <Label.Text>
                                                        <Binding Path="CardNumber" TargetNullValue="—" FallbackValue="—" />
                                                    </Label.Text>
                                                </Label>
                                            </Frame>

                                            <Grid Grid.Column="5" ColumnDefinitions="*,*" ColumnSpacing="5" HeightRequest="30" VerticalOptions="Center">
                                                <Button Text="Vizualizare"
            Grid.Column="0"
            FontSize="12"
            CornerRadius="5"
            VerticalOptions="Fill"
            HorizontalOptions="Fill"
            Padding="0,1,0,14"
            Command="{Binding Source={x:Reference CollectionViewReference}, Path=BindingContext.OpenMonitoringCommand}"
            CommandParameter="{Binding .}"/>

                                                <Button Text="Șterge"
            Grid.Column="1"
            Style="{StaticResource DangerButton}"
            CornerRadius="5"
            VerticalOptions="Fill"
            HorizontalOptions="Fill"
            Padding="0,1,0,14"
            Command="{Binding Source={x:Reference CollectionViewReference}, Path=BindingContext.DeleteMonitoringCommand}"
            CommandParameter="{Binding .}"/>
                                            </Grid>


                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>

                            </CollectionView>

                        </StackLayout>
                    </Frame>


                    <Label IsVisible="{Binding HasData, Converter={StaticResource InvertedBoolConverter}}"
                           Text="Nu au fost gasite date pentru criteriile selectate."
                           FontSize="16"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalTextAlignment="Center"
                           Margin="20"/>
                </StackLayout>
            </Frame>

            <ActivityIndicator IsVisible="{Binding IsGeneratingReport}" 
                              IsRunning="{Binding IsGeneratingReport}"
                              />

            <Label Text="Se genereaza PDF-ul..."
                   IsVisible="{Binding IsGeneratingReport}"
                   HorizontalOptions="Center"
                   FontAttributes="Italic"
                   TextColor="{StaticResource TextSecondary}"/>

        </StackLayout>
    </ScrollView>
</ContentPage>