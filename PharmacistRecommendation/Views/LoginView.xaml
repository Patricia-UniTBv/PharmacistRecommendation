<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PharmacistRecommendation.Views.LoginView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:PharmacistRecommendation.Helpers"
             xmlns:viewmodels="clr-namespace:PharmacistRecommendation.ViewModels"
             x:DataType="viewmodels:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource NavyHeader}">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Padding="24,48">

            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Background="{StaticResource SurfaceBrush}"
                    WidthRequest="400"
                    HorizontalOptions="Center">
                <VerticalStackLayout Spacing="14" Padding="28,24">

                    <Label Text="Autentificare"
                           FontFamily="OpenSansSemiBold"
                           FontSize="20"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center"/>
                    <Label Text="Sistemul de recomandări pentru farmacii"
                           FontSize="13"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Center"
                           Margin="0,0,0,8"/>

                    <Label Text="NUME UTILIZATOR" Style="{StaticResource FieldLabel}"/>
                    <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="12,0" HeightRequest="40">
                        <Entry Text="{Binding Username}"
                               Placeholder="Introduceți numele de utilizator"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"
                               ReturnType="Next">
                            <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                        </Entry>
                    </Border>

                    <Label Text="PAROLĂ" Style="{StaticResource FieldLabel}"/>
                    <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="12,0" HeightRequest="40">
                        <Entry Text="{Binding Password}"
                               Placeholder="Introduceți parola"
                               IsPassword="True"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"
                               ReturnType="Done"
                               ReturnCommand="{Binding LoginCommand}">
                            <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                        </Entry>
                    </Border>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource Error}"
                           FontSize="12"
                           IsVisible="{Binding HasError}"
                           HorizontalOptions="Center"/>

                    <Button Text="Autentificare"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsNotLoading}"
                            HeightRequest="42"
                            Margin="0,6,0,0"/>

                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="{StaticResource Primary}"
                                       HorizontalOptions="Center"/>

                    <Button Text="Ai uitat parola?"
                            Command="{Binding ForgotPasswordCommand}"
                            Style="{StaticResource GhostButton}"
                            HorizontalOptions="Center"
                            FontSize="12"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="© 2025 Recomandarea Farmacistului"
                   FontSize="11"
                   TextColor="#475569"
                   HorizontalOptions="Center"
                   Margin="0,16,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
