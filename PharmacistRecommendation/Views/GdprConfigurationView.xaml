<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PharmacistRecommendation.Views.GdprConfigurationView"
             BackgroundColor="{StaticResource Background}">
    <Grid Padding="16" RowDefinitions="Auto,*,Auto" RowSpacing="12">

        <Label Grid.Row="0"
               Text="Modificare document GDPR"
               Style="{StaticResource PageTitle}"
               Margin="0,8,0,0"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">
                <Editor Text="{Binding ConsentTemplate, Mode=TwoWay}"
                        AutoSize="TextChanges"
                        HeightRequest="450"
                        IsEnabled="true"/>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
            </VerticalStackLayout>
        </ScrollView>

        <HorizontalStackLayout Grid.Row="2" Spacing="10" HorizontalOptions="End">
            <Button Text="Salvează"
                    Command="{Binding SaveConsentTemplateCommand}"/>
            <Button Text="Resetează la implicit"
                    Command="{Binding ResetConsentTemplateCommand}"
                    Style="{StaticResource OutlineButton}"/>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
