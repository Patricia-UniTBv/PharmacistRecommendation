<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PharmacistRecommendation.ViewModels"
             xmlns:conv="clr-namespace:PharmacistRecommendation.Converters"
             xmlns:models="clr-namespace:Entities.Models;assembly=Entities"
             xmlns:dto="clr-namespace:DTO;assembly=DTO"
             xmlns:helpers="clr-namespace:PharmacistRecommendation.Helpers"
             x:Class="PharmacistRecommendation.Views.AdminDashboardView"
             x:DataType="vm:AdminDashboardViewModel"
             BackgroundColor="{StaticResource Surface}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:MonitoringTypeConverter x:Key="MonitoringTypeConverter"/>
            <Color x:Key="HeaderGray">#D3D3D3</Color>
            <Color x:Key="BorderGray">#CCCCCC</Color>
            <Color x:Key="TextGray">#333333</Color>
            <Color x:Key="LightGray">#F5F5F5</Color>
            <Color x:Key="ActiveTab">#2D6CB0</Color>
            <Color x:Key="ActiveTabText">White</Color>
            <Color x:Key="InactiveTab">#E8EDF5</Color>
            <Color x:Key="EditPanel">#F0F4FA</Color>

            <Style x:Key="TabButton" TargetType="Button">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="BackgroundColor" Value="{StaticResource InactiveTab}"/>
                <Setter Property="TextColor" Value="{StaticResource TextGray}"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="HeightRequest" Value="36"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Margin" Value="3,0"/>
            </Style>

            <Style x:Key="ActiveTabButton" TargetType="Button">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="BackgroundColor" Value="{StaticResource ActiveTab}"/>
                <Setter Property="TextColor" Value="{StaticResource ActiveTabText}"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="HeightRequest" Value="36"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Margin" Value="3,0"/>
            </Style>

            <Style x:Key="ActionBtn" TargetType="Button">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="BackgroundColor" Value="{StaticResource Gray200}"/>
                <Setter Property="TextColor" Value="{StaticResource TextGray}"/>
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="HeightRequest" Value="30"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Margin" Value="2"/>
            </Style>

            <Style x:Key="FieldBorderStyle" TargetType="Border">
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeShape"     Value="RoundRectangle 4"/>
                <Setter Property="Stroke"          Value="{StaticResource BorderDefault}"/>
                <Setter Property="HeightRequest"   Value="34"/>
                <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="Padding"         Value="8,0"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- HEADER -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource HeaderGray}"
                Stroke="{StaticResource BorderGray}"
                StrokeThickness="1"
                Padding="12,8">
            <Grid>
                <Label Text="Panou Administrare Date"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextGray}"
                       VerticalOptions="Center"/>
                <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="Center" Spacing="8">
                    <Button Text="← Înapoi"
                            Clicked="OnNavigateBack"
                            Style="{StaticResource OutlineButton}"
                            HeightRequest="32"
                            Padding="12,0"/>
                    <Button Text="✕ Închidere"
                            Clicked="OnCloseApp"
                            Style="{StaticResource DangerButton}"
                            HeightRequest="32"
                            Padding="12,0"/>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- TAB BAR -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource BorderGray}"
                StrokeThickness="0,0,0,1"
                Padding="8,6">
            <HorizontalStackLayout Spacing="0">
                <Button Text="Pacienți"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="patients"
                        Style="{StaticResource TabButton}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsPatientsVisible}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource ButtonHover}"/>
                            <Setter Property="TextColor" Value="White"/>
                            <Setter Property="FontAttributes" Value="Bold"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="Utilizatori"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="users"
                        Style="{StaticResource TabButton}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsUsersVisible}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource ButtonHover}"/>
                            <Setter Property="TextColor" Value="White"/>
                            <Setter Property="FontAttributes" Value="Bold"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="Rețete / Acte"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="prescriptions"
                        Style="{StaticResource TabButton}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsPrescriptionsVisible}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource ButtonHover}"/>
                            <Setter Property="TextColor" Value="White"/>
                            <Setter Property="FontAttributes" Value="Bold"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="Monitorizări"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="monitorings"
                        Style="{StaticResource TabButton}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsMonitoringsVisible}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource ButtonHover}"/>
                            <Setter Property="TextColor" Value="White"/>
                            <Setter Property="FontAttributes" Value="Bold"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="2">

            <!-- ═══════════ PATIENTS TAB ═══════════ -->
            <Grid RowDefinitions="Auto,Auto,*"
                  IsVisible="{Binding IsPatientsVisible}">

                <!-- Filter bar -->
                <Border Grid.Row="0" BackgroundColor="{StaticResource LightGray}" Padding="8,6"
                        Stroke="{StaticResource BorderGray}" StrokeThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="Căutare:" VerticalOptions="Center" FontSize="13"/>
                        <Border Grid.Column="1" Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="8,0" HeightRequest="32">
                            <Entry Placeholder="Nume, CNP sau nr. card" Text="{Binding PatientSearchText}" FontSize="13" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </Grid>
                </Border>

                <!-- Column headers -->
                <Grid Grid.Row="1" ColumnDefinitions="2*,2*,1.5*,1.5*,2*,1.5*,Auto"
                      BackgroundColor="{StaticResource HeaderGray}"
                      Padding="10,6">
                    <Label Grid.Column="0" Text="Nume"       FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="1" Text="Prenume"    FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="2" Text="CNP"        FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="3" Text="Nr. Card"   FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="4" Text="Email"      FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="5" Text="Telefon"    FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="6" Text=""           FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                </Grid>

                <!-- List -->
                <CollectionView Grid.Row="2" ItemsSource="{Binding Patients}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Patient">
                            <Border Stroke="{StaticResource BorderGray}" StrokeThickness="0,0,0,1">
                                <Grid ColumnDefinitions="2*,2*,1.5*,1.5*,2*,1.5*,Auto"
                                      Padding="10,4" MinimumHeightRequest="38">
                                    <Label Grid.Column="0" Text="{Binding LastName}"   FontSize="13" VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="1" Text="{Binding FirstName}"  FontSize="13" VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="2" Text="{Binding Cnp}"        FontSize="13" VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="3" Text="{Binding CardNumber}" FontSize="13" VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="4" Text="{Binding Email}"      FontSize="13" VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="5" Text="{Binding Phone}"      FontSize="13" VerticalTextAlignment="Center"/>
                                    <Button Grid.Column="6" Text="Editează"
                                            Style="{StaticResource ActionBtn}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminDashboardViewModel}}, Path=EditPatientCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- ═══════════ USERS TAB ═══════════ -->
            <Grid RowDefinitions="Auto,Auto,*"
                  IsVisible="{Binding IsUsersVisible}">

                <Border Grid.Row="0" BackgroundColor="{StaticResource LightGray}" Padding="8,6"
                        Stroke="{StaticResource BorderGray}" StrokeThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="Rol:" VerticalOptions="Center" FontSize="13"/>
                        <Picker Grid.Column="1" ItemsSource="{Binding UserRoleFilters}"
                                SelectedItem="{Binding SelectedUserRoleFilter}"
                                WidthRequest="140" FontSize="13"/>
                        <Label Grid.Column="2" Text="Căutare:" VerticalOptions="Center" FontSize="13"/>
                        <Border Grid.Column="3" Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="8,0" HeightRequest="32">
                            <Entry Placeholder="Nume sau username" Text="{Binding UserSearchText}" FontSize="13" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="2*,2*,1.5*,2*,2*,1.5*,Auto"
                      BackgroundColor="{StaticResource HeaderGray}" Padding="10,6">
                    <Label Grid.Column="0" Text="Nume"      FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="1" Text="Prenume"   FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="2" Text="Rol"       FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="3" Text="Username"  FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="4" Text="Email"     FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="5" Text="NCM"       FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="6" Text=""          FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                </Grid>

                <CollectionView Grid.Row="2" ItemsSource="{Binding Users}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:UserDTO">
                            <Border Stroke="{StaticResource BorderGray}" StrokeThickness="0,0,0,1">
                                <Grid ColumnDefinitions="2*,2*,1.5*,2*,2*,1.5*,Auto"
                                      Padding="10,4" MinimumHeightRequest="38">
                                    <Label Grid.Column="0" Text="{Binding LastName}"  FontSize="13" VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="1" Text="{Binding FirstName}" FontSize="13" VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="2" Text="{Binding Role}"      FontSize="13" VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="3" Text="{Binding Username}"  FontSize="13" VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="4" Text="{Binding Email}"     FontSize="13" VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="5" Text="{Binding Ncm}"       FontSize="13" VerticalTextAlignment="Center"/>
                                    <Button Grid.Column="6" Text="Editează"
                                            Style="{StaticResource ActionBtn}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminDashboardViewModel}}, Path=EditUserCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- ═══════════ PRESCRIPTIONS TAB ═══════════ -->
            <Grid RowDefinitions="Auto,Auto,*"
                  IsVisible="{Binding IsPrescriptionsVisible}">

                <Border Grid.Row="0" BackgroundColor="{StaticResource LightGray}" Padding="8,6"
                        Stroke="{StaticResource BorderGray}" StrokeThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="De la:" VerticalOptions="Center" FontSize="13"/>
                        <DatePicker Grid.Column="1" Date="{Binding PrescriptionFromDate}" FontSize="13"/>
                        <Label Grid.Column="2" Text="Până la:" VerticalOptions="Center" FontSize="13"/>
                        <DatePicker Grid.Column="3" Date="{Binding PrescriptionToDate}" FontSize="13"/>
                        <Label Grid.Column="4" Text="Căutare:" VerticalOptions="Center" FontSize="13"/>
                        <Border Grid.Column="5" Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="8,0" HeightRequest="32">
                            <Entry Placeholder="Pacient, serie sau nr." Text="{Binding PrescriptionSearchText}" FontSize="13" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="1.2*,2*,1.5*,1*,2*,Auto"
                      BackgroundColor="{StaticResource HeaderGray}" Padding="10,6">
                    <Label Grid.Column="0" Text="Data"              FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="1" Text="Pacient"           FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="2" Text="CNP Pacient"       FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="3" Text="Serie / Nr."       FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="4" Text="Serviciu farmac."  FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="5" Text=""                  FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                </Grid>

                <CollectionView Grid.Row="2" ItemsSource="{Binding Prescriptions}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Prescription">
                            <Border Stroke="{StaticResource BorderGray}" StrokeThickness="0,0,0,1">
                                <Grid ColumnDefinitions="1.2*,2*,1.5*,1*,2*,Auto"
                                      Padding="10,4" MinimumHeightRequest="38">
                                    <Label Grid.Column="0" Text="{Binding IssueDate, StringFormat='{0:dd.MM.yyyy}'}" FontSize="13" VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="1" Text="{Binding PatientName}"           FontSize="13" VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="2" Text="{Binding PatientCnp}"            FontSize="13" VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="3" Text="{Binding Series}"                FontSize="13" VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="4" Text="{Binding PharmaceuticalService}" FontSize="13" VerticalTextAlignment="Center"/>
                                    <Button Grid.Column="5" Text="Editează"
                                            Style="{StaticResource ActionBtn}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminDashboardViewModel}}, Path=EditPrescriptionCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- ═══════════ MONITORING TAB ═══════════ -->
            <Grid RowDefinitions="Auto,Auto,*"
                  IsVisible="{Binding IsMonitoringsVisible}">

                <Border Grid.Row="0" BackgroundColor="{StaticResource LightGray}" Padding="8,6"
                        Stroke="{StaticResource BorderGray}" StrokeThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="De la:" VerticalOptions="Center" FontSize="13"/>
                        <DatePicker Grid.Column="1" Date="{Binding MonitoringFromDate}" FontSize="13"/>
                        <Label Grid.Column="2" Text="Până la:" VerticalOptions="Center" FontSize="13"/>
                        <DatePicker Grid.Column="3" Date="{Binding MonitoringToDate}" FontSize="13"/>
                        <Label Grid.Column="4" Text="Tip:" VerticalOptions="Center" FontSize="13"/>
                        <Picker Grid.Column="5" ItemsSource="{Binding MonitoringTypeFilters}"
                                SelectedItem="{Binding SelectedMonitoringTypeFilter}"
                                WidthRequest="130" FontSize="13"/>
                        <Label Grid.Column="6" Text="Căutare:" VerticalOptions="Center" FontSize="13"/>
                        <Border Grid.Column="7" Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="8,0" HeightRequest="32">
                            <Entry Placeholder="Pacient sau CNP" Text="{Binding MonitoringSearchText}" FontSize="13" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="1.2*,2*,1.5*,1*,1*,2*,Auto"
                      BackgroundColor="{StaticResource HeaderGray}" Padding="10,6">
                    <Label Grid.Column="0" Text="Data"       FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="1" Text="Pacient"    FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="2" Text="CNP"        FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="3" Text="Tip"        FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="4" Text="Înălțime"   FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="5" Text="Note"       FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                    <Label Grid.Column="6" Text=""           FontAttributes="Bold" FontSize="12" VerticalTextAlignment="Center"/>
                </Grid>

                <CollectionView Grid.Row="2" ItemsSource="{Binding Monitorings}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Monitoring">
                            <Border Stroke="{StaticResource BorderGray}" StrokeThickness="0,0,0,1">
                                <Grid ColumnDefinitions="1.2*,2*,1.5*,1*,1*,2*,Auto"
                                      Padding="10,4" MinimumHeightRequest="38">
                                    <Label Grid.Column="0" Text="{Binding MonitoringDate, StringFormat='{0:dd.MM.yyyy}'}"           FontSize="13" VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="1" Text="{Binding Patient.LastName, StringFormat='{0} '}"                   FontSize="13" VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="2" Text="{Binding Patient.Cnp}"                                             FontSize="13" VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="3" Text="{Binding ParametersJson, Converter={StaticResource MonitoringTypeConverter}}" FontSize="13" VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="4" Text="{Binding Height, StringFormat='{0} cm'}"                           FontSize="13" VerticalTextAlignment="Center"/>
                                    <Label Grid.Column="5" Text="{Binding Notes}"                                                   FontSize="13" VerticalTextAlignment="Center" LineBreakMode="TailTruncation"/>
                                    <Button Grid.Column="6" Text="Editează"
                                            Style="{StaticResource ActionBtn}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminDashboardViewModel}}, Path=EditMonitoringCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

        </Grid>

        <!-- EDIT PANEL -->
        <Border Grid.Row="3"
                IsVisible="{Binding IsAnyEditVisible}"
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource Primary}"
                StrokeThickness="0,2,0,0"
                Padding="16,10,16,12">
            <Grid>

                <!-- Patient edit -->
                <VerticalStackLayout IsVisible="{Binding IsPatientEditVisible}" Spacing="8">
                    <Grid>
                        <Label Text="Editare pacient"
                               FontSize="13" FontFamily="OpenSansSemiBold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"/>
                        <HorizontalStackLayout HorizontalOptions="End" Spacing="8" VerticalOptions="Center">
                            <Button Text="Anulează" Command="{Binding CancelPatientEditCommand}"
                                    Style="{StaticResource OutlineButton}" Padding="14,6"/>
                            <Button Text="Salvează" Command="{Binding SavePatientCommand}"
                                    Padding="14,6"/>
                        </HorizontalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*,*,*,*,0.7*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Nume" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry Text="{Binding EditPatientLastName}" BackgroundColor="Transparent" FontSize="12">
                                    <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Prenume" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry Text="{Binding EditPatientFirstName}" BackgroundColor="Transparent" FontSize="12">
                                    <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label Text="CNP" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry Text="{Binding EditPatientCnp}" BackgroundColor="Transparent" FontSize="12">
                                    <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3" Spacing="2">
                            <Label Text="CID" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry Text="{Binding EditPatientCid}" BackgroundColor="Transparent" FontSize="12">
                                    <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="4" Spacing="2">
                            <Label Text="Email" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry Text="{Binding EditPatientEmail}" BackgroundColor="Transparent" FontSize="12" Keyboard="Email">
                                    <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="5" Spacing="2">
                            <Label Text="Telefon" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry Text="{Binding EditPatientPhone}" BackgroundColor="Transparent" FontSize="12" Keyboard="Telephone">
                                    <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="6" Spacing="2">
                            <Label Text="Gen" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Picker ItemsSource="{Binding GenderOptions}"
                                        SelectedItem="{Binding EditPatientGender}"
                                        FontSize="12" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <!-- User edit -->
                <VerticalStackLayout IsVisible="{Binding IsUserEditVisible}" Spacing="8">
                    <Grid>
                        <Label Text="Editare utilizator"
                               FontSize="13" FontFamily="OpenSansSemiBold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"/>
                        <HorizontalStackLayout HorizontalOptions="End" Spacing="8" VerticalOptions="Center">
                            <Button Text="Anulează" Command="{Binding CancelUserEditCommand}"
                                    Style="{StaticResource OutlineButton}" Padding="14,6"/>
                            <Button Text="Salvează" Command="{Binding SaveUserCommand}"
                                    Padding="14,6"/>
                        </HorizontalStackLayout>
                    </Grid>
                    <!-- Row 1: identity fields -->
                    <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Nume" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry Text="{Binding EditUserLastName}" BackgroundColor="Transparent" FontSize="12">
                                    <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Prenume" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry Text="{Binding EditUserFirstName}" BackgroundColor="Transparent" FontSize="12">
                                    <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label Text="Username" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry Text="{Binding EditUserUsername}" BackgroundColor="Transparent" FontSize="12">
                                    <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3" Spacing="2">
                            <Label Text="Email" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry Text="{Binding EditUserEmail}" BackgroundColor="Transparent" FontSize="12" Keyboard="Email">
                                    <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="4" Spacing="2">
                            <Label Text="Telefon" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry Text="{Binding EditUserPhone}" BackgroundColor="Transparent" FontSize="12" Keyboard="Telephone">
                                    <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="5" Spacing="2">
                            <Label Text="NCM" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry Text="{Binding EditUserNcm}" BackgroundColor="Transparent" FontSize="12">
                                    <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                    <!-- Row 2: password fields -->
                    <Grid ColumnDefinitions="*,*,2*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Parolă nouă" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry Text="{Binding EditUserNewPassword}" IsPassword="True" BackgroundColor="Transparent" FontSize="12" Placeholder="(nemodificată)">
                                    <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Confirmare parolă" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry Text="{Binding EditUserConfirmPassword}" IsPassword="True" BackgroundColor="Transparent" FontSize="12" Placeholder="(nemodificată)">
                                    <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>
                        <BoxView Grid.Column="2" Color="Transparent"/>
                    </Grid>
                </VerticalStackLayout>

                <!-- Prescription edit -->
                <VerticalStackLayout IsVisible="{Binding IsPrescriptionEditVisible}" Spacing="8">
                    <Grid>
                        <Label Text="Editare rețetă / act"
                               FontSize="13" FontFamily="OpenSansSemiBold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"/>
                        <HorizontalStackLayout HorizontalOptions="End" Spacing="8" VerticalOptions="Center">
                            <Button Text="Anulează" Command="{Binding CancelPrescriptionEditCommand}"
                                    Style="{StaticResource OutlineButton}" Padding="14,6"/>
                            <Button Text="Salvează" Command="{Binding SavePrescriptionCommand}"
                                    Padding="14,6"/>
                        </HorizontalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Diagnostic" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}" HeightRequest="60">
                                <Editor Text="{Binding EditPrescriptionDiagnosis}" BackgroundColor="Transparent" FontSize="12" AutoSize="Disabled"/>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Observații farmacist" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}" HeightRequest="60">
                                <Editor Text="{Binding EditPrescriptionObservations}" BackgroundColor="Transparent" FontSize="12" AutoSize="Disabled"/>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label Text="Recomandare farmacist" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}" HeightRequest="60">
                                <Editor Text="{Binding EditPrescriptionRecommendation}" BackgroundColor="Transparent" FontSize="12" AutoSize="Disabled"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <!-- Monitoring edit -->
                <VerticalStackLayout IsVisible="{Binding IsMonitoringEditVisible}" Spacing="8">
                    <Grid>
                        <Label Text="Editare monitorizare"
                               FontSize="13" FontFamily="OpenSansSemiBold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"/>
                        <HorizontalStackLayout HorizontalOptions="End" Spacing="8" VerticalOptions="Center">
                            <Button Text="Anulează" Command="{Binding CancelMonitoringEditCommand}"
                                    Style="{StaticResource OutlineButton}" Padding="14,6"/>
                            <Button Text="Salvează" Command="{Binding SaveMonitoringCommand}"
                                    Padding="14,6"/>
                        </HorizontalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,2*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Înălțime (cm)" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry Text="{Binding EditMonitoringHeight}" Keyboard="Numeric" BackgroundColor="Transparent" FontSize="12">
                                    <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Greutate (kg)" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}">
                                <Entry Text="{Binding EditMonitoringWeight}" Keyboard="Numeric" BackgroundColor="Transparent" FontSize="12">
                                    <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label Text="Note" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBorderStyle}" HeightRequest="60">
                                <Editor Text="{Binding EditMonitoringNotes}" BackgroundColor="Transparent" FontSize="12" AutoSize="Disabled"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

            </Grid>
        </Border>

    </Grid>
</ContentPage>
