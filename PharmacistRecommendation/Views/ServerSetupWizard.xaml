<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:PharmacistRecommendation.ViewModels"
    x:Class="PharmacistRecommendation.Views.ServerSetupWizard"
    x:DataType="viewmodels:ServerSetupWizardViewModel"
    Title="Configurare Server"
    BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <Grid Padding="40,60,40,40"
              RowDefinitions="Auto,*,Auto"
              RowSpacing="32"
              MaximumWidthRequest="700"
              HorizontalOptions="Center">

            <StackLayout Grid.Row="0" Spacing="16">
                <Label Text="Bine ați venit!"
                       Style="{StaticResource Headline}"/>
                <Label Text="Configurare Server Farmacie"
                       Style="{StaticResource SubHeadline}"/>
                <BoxView HeightRequest="3"
                         WidthRequest="60"
                         BackgroundColor="{StaticResource Primary}"
                         HorizontalOptions="Center"
                         CornerRadius="2"
                         Margin="0,8,0,0"/>
            </StackLayout>

            <Border Grid.Row="1"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource Surface}"
                    Padding="40">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource BorderDefault}" Offset="0,2" Radius="8" Opacity="0.15"/>
                </Border.Shadow>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="24">

                    <StackLayout Spacing="12">
                        <Label Text="Pregătim serverul dumneavoastră"
                               FontFamily="OpenSansSemiBold"
                               FontSize="18"
                               TextColor="{StaticResource Primary}"/>
                        <Label FontSize="15"
                               TextColor="{StaticResource TextPrimary}"
                               LineHeight="1.5">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Acest asistent va crea baza de date a farmaciei pe computerul dumneavoastră.&#x0a;&#x0a;"/>
                                    <Span Text="Locația: " FontAttributes="Bold"/>
                                    <Span Text="localhost\PHARMACYREC&#x0a;"/>
                                    <Span Text="Bază de date: " FontAttributes="Bold"/>
                                    <Span Text="PharmacistRecommendationDB&#x0a;&#x0a;"/>
                                    <Span Text="Procesul durează aproximativ 2-3 minute." FontAttributes="Italic" TextColor="{StaticResource TextSecondary}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </StackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}"/>

                    <Button Text="Creare Bază de Date"
                            FontSize="16"
                            FontAttributes="Bold"
                            Command="{Binding CreateDatabaseCommand}"
                            HeightRequest="52"
                            IsEnabled="{Binding IsCreating, Converter={StaticResource InvertedBoolConverter}}"
                            IsVisible="{Binding IsCompleted, Converter={StaticResource InvertedBoolConverter}}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsCreating}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLight}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <StackLayout Spacing="16" IsVisible="{Binding IsCreating}">
                        <ActivityIndicator IsRunning="{Binding IsCreating}"
                                           HeightRequest="40" WidthRequest="40"
                                           HorizontalOptions="Center"/>
                        <Label Text="{Binding ProgressMessage}"
                               FontSize="14"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center"
                               FontAttributes="Italic"/>
                        <ProgressBar Progress="{Binding ProgressValue}"
                                     HeightRequest="8"
                                     Margin="0,8,0,0"/>
                        <Label Text="Vă rugăm să așteptați... Nu închideți aplicația."
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center"
                               FontAttributes="Italic"/>
                    </StackLayout>

                    <Border IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
                            Padding="20"
                            StrokeShape="RoundRectangle 12"
                            Margin="0,8,0,0">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding HasError}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource ErrorLight}"/>
                                <Setter Property="Stroke" Value="{StaticResource Error}"/>
                                <Setter Property="StrokeThickness" Value="2"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource SuccessLight}"/>
                                <Setter Property="Stroke" Value="{StaticResource Success}"/>
                                <Setter Property="StrokeThickness" Value="2"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding StatusMessage}" FontSize="14" LineHeight="1.6">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding HasError}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource Error}"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource Success}"/>
                                    <Setter Property="FontAttributes" Value="Bold"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout Grid.Row="2"
                                   Spacing="16"
                                   HorizontalOptions="Center"
                                   Margin="0,16,0,0">

                <Button Text="Anulare"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource OutlineButton}"
                        WidthRequest="140"
                        HeightRequest="48"
                        IsVisible="{Binding IsCompleted, Converter={StaticResource InvertedBoolConverter}}"
                        IsEnabled="{Binding IsCreating, Converter={StaticResource InvertedBoolConverter}}"/>

                <Button Text="Finalizare"
                        FontAttributes="Bold"
                        Command="{Binding FinishCommand}"
                        WidthRequest="140"
                        HeightRequest="48"
                        IsVisible="{Binding IsCompleted}"/>

            </HorizontalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>
