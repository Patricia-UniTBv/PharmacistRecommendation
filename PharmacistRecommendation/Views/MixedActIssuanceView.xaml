<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PharmacistRecommendation.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:PharmacistRecommendation.ViewModels"
    x:Class="PharmacistRecommendation.Views.MixedActIssuanceView"
    x:Name="MixedActIssuance"
    BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="4" BackgroundColor="White">
            <HorizontalStackLayout Spacing="10" Padding="0,0,0,8">
               
                <Label Text="{Binding PageTitle}"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       HorizontalOptions="StartAndExpand"
                       TextColor="#222" />
                <Button Text="Recomandare nou"
                         Command="{Binding NewRecommendationCommand}"
                         FontSize="14" HeightRequest="34"
                         BackgroundColor="#ece8fa" TextColor="#36317f"
                         CornerRadius="8" />
                <Button Text="Import date"
                         Command="{Binding ImportDataCommand}"
                         FontSize="14" HeightRequest="34"
                         BackgroundColor="#007bff"
                         CornerRadius="8" />
            </HorizontalStackLayout>

            <Frame CornerRadius="14" BorderColor="#e0e3e9" Padding="14" HeightRequest ="80" BackgroundColor="White">
                <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Nr. card" TextColor="Black" FontAttributes="Bold"/>
                        <Entry Placeholder="Card nr." Text="{Binding CardNumber}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Pacient" TextColor="Black"  FontAttributes="Bold"/>
                        <Entry Placeholder="Pacient" Text="{Binding PatientName}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2">
                        <Label Text="CNP/CID pacient" TextColor="Black"  FontAttributes="Bold"/>
                        <Entry Placeholder="CNP/CID pacient" Text="{Binding PatientCnp}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3">
                        <Label Text="Aparintor" TextColor="Black"  FontAttributes="Bold"/>
                        <Entry Placeholder="Aparintor" Text="{Binding CaregiverName}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="4">
                        <Label Text="CNP/CID aparintor" TextColor="Black"  FontAttributes="Bold"/>
                        <Entry Placeholder="CNP/CID aparintor" Text="{Binding CaregiverCnp}" />
                    </VerticalStackLayout>
                </Grid>
            </Frame>


            <Label Text="Diagnostic menionat de pacient/aparintor" TextColor="Black" FontAttributes="Bold"/>
            <Entry Placeholder="Diagnostic menionat de pacient/aparintor" Text="{Binding PatientDiagnosis}" />

            <VerticalStackLayout Padding="5">
                <Label Text="Medicamente utilizate de pacient"
           TextColor="Black"
           FontAttributes="Bold"/>

                <Entry Text="{Binding SearchText}" 
                       x:Name="SearchEntry"
                       Placeholder="Caut medicament..." 
                       TextChanged="OnSearchTextChanged"/>

                <CollectionView ItemsSource="{Binding Suggestions}" 
                    SelectionMode="Single"
                    MaximumHeightRequest="100"
                    VerticalScrollBarVisibility="Always"
                    IsVisible="{Binding HasSuggestions}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding}" Padding="5">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer 
    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddSuggestionCommand}" 
    CommandParameter="{Binding .}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>


            <Frame CornerRadius="12" BorderColor="#e0e3e9" Padding="16" BackgroundColor="White" IsVisible="{Binding ShowWithPrescription}" HeightRequest ="90" >
                <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto" BackgroundColor="White" ColumnSpacing="16">
                    <VerticalStackLayout Grid.Column="0" Spacing="4" BackgroundColor="White">
                        <Label Text="Parafa medic" TextColor="Black"  FontAttributes="Bold"/>
                        <Entry Placeholder="Parafa medic" Text="{Binding DoctorStamp}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" BackgroundColor="White">
                        <Label Text="Seria" TextColor="Black"  FontAttributes="Bold"/>
                        <Entry Placeholder="Seria" Text="{Binding PrescriptionSeries}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="4" BackgroundColor="White">
                        <Label Text="Numr" TextColor="Black"  FontAttributes="Bold"/>
                        <Entry Placeholder="Numr" Text="{Binding PrescriptionNumber}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" Spacing="4" BackgroundColor="White">
                        <Label Text="Diagnostic" TextColor="Black"  FontAttributes="Bold"/>
                        <Entry Placeholder="Diagnostic" Text="{Binding PrescriptionDiagnosis}"/>
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <Frame CornerRadius="10" BorderColor="#ececec" Padding="12" BackgroundColor="White" HeightRequest ="80" >
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto" ColumnSpacing="16" BackgroundColor="White">
                    <VerticalStackLayout Grid.Column="0" Spacing="4" BackgroundColor="White">
                        <Label Text="Simptomatologie" TextColor="Black"  FontAttributes="Bold"/>
                        <Entry Placeholder="Simptomatologie" 
                   Text="{Binding Symptoms}" 
                   BackgroundColor="White"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" BackgroundColor="White">
                        <Label Text="Suspiciune" TextColor="Black"  FontAttributes="Bold"/>
                        <Entry Placeholder="Suspiciune" 
                   Text="{Binding Suspicion}" 
                   BackgroundColor="White" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="4" BackgroundColor="White">
                        <Label Text="Constatrile farmacistului" TextColor="Black"  FontAttributes="Bold"/>
                        <Entry Placeholder="Constatrile farmacistului" 
                   Text="{Binding PharmacistObservations}" 
                   BackgroundColor="White"/>
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <!-- Medications With Prescription -->
            <StackLayout Orientation="Horizontal" VerticalOptions="Center" Spacing="5"
             IsVisible="{Binding ShowWithPrescription}">
                <Label Text="Medicamente eliberate cu reet"
           FontAttributes="Bold"
           Margin="0,4"
           TextColor="#222"/>

                <Button Text="+"
        Command="{Binding AddMedicationWithPrescriptionCommand}"
        IsVisible="{Binding ShowWithPrescription}" 
        FontSize="16"
        HeightRequest="20"
        WidthRequest="20"
        MinimumHeightRequest="28"
        MinimumWidthRequest="28"
        CornerRadius="9"
        BackgroundColor="#ece8fa"
        TextColor="#34495E"
        Padding="0"
        VerticalOptions="Center" />

            </StackLayout>

            <Frame CornerRadius="8" BorderColor="#e8eaf1" Padding="6" BackgroundColor="White" IsVisible="{Binding ShowWithPrescription}">
                <VerticalStackLayout Spacing="6">
                    <CollectionView ItemsSource="{Binding MedicationsWithPrescription}">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="36,*,100,100,110,110,110,110,160,60">
                                <Label Grid.Column="0" Text="NR. CRT." FontAttributes="Bold" FontSize="12" TextColor="#34495E"/>
                                <Label Grid.Column="1" Text="MEDICAMENT" FontAttributes="Bold" FontSize="12" TextColor="#34495E"/>
                                <Label Grid.Column="2" Text="CANTITATE TOTAL" FontAttributes="Bold" FontSize="12" TextColor="#34495E"/>
                                <Label Grid.Column="3" Text="ZILE TRATAM." FontAttributes="Bold" FontSize="12" TextColor="#34495E"/>
                                <Label Grid.Column="4" Text="DIMINEAA" FontAttributes="Bold" FontSize="12" TextColor="#34495E"/>
                                <Label Grid.Column="5" Text="PRNZ" FontAttributes="Bold" FontSize="12" TextColor="#34495E"/>
                                <Label Grid.Column="6" Text="SEARA" FontAttributes="Bold" FontSize="12" TextColor="#34495E"/>
                                <Label Grid.Column="7" Text="NOAPTEA" FontAttributes="Bold" FontSize="12" TextColor="#34495E"/>
                                <Label Grid.Column="8" Text="MOD ADMINISTRARE" FontAttributes="Bold" FontSize="12" TextColor="#34495E"/>
                                <Label Text=" " />
                            </Grid>
                        </CollectionView.Header>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="36,*,100,100,110,110,110,110,160,60" Padding="2">
                                    <Label Grid.Column="0" Text="{Binding Index}" VerticalOptions="Center" HorizontalOptions="Center" TextColor="Black"/>

                                    <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Entry Text="{Binding Name}" Placeholder="Nume medicament" HorizontalOptions="FillAndExpand"/>
                                        <Button Text=""
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    BackgroundColor="Transparent"
                                    BorderColor="Transparent"
                                    BorderWidth="0"
                                    Padding="0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenMedicationPopupCommand}"
                                    CommandParameter="{Binding .}"/>
                                    </StackLayout>

                                    <Entry Grid.Column="2" Text="{Binding TotalQuantity, Mode=TwoWay}" Placeholder="Total" VerticalOptions="Center" HorizontalOptions="Center" TextColor="Black"/>
                                    <Entry Grid.Column="3" Text="{Binding TotalDays, Mode=TwoWay}" Placeholder="Nr. zile" VerticalOptions="Center" HorizontalOptions="Center" TextColor="Black"/>
                                    <Entry Grid.Column="4" Text="{Binding Morning}" Placeholder="Cantitate" Keyboard="Numeric" BackgroundColor="White"/>
                                    <Entry Grid.Column="5" Text="{Binding Noon}" Placeholder="Cantitate" Keyboard="Numeric" BackgroundColor="White"/>
                                    <Entry Grid.Column="6" Text="{Binding Evening}" Placeholder="Cantitate" Keyboard="Numeric" BackgroundColor="White"/>
                                    <Entry Grid.Column="7" Text="{Binding Night}" Placeholder="Cantitate" Keyboard="Numeric" BackgroundColor="White"/>

                                    <Picker Grid.Column="8"
                                TitleColor="LightGray"
                                ItemsSource="{Binding BindingContext.AdministrationModes, Source={x:Reference MixedActIssuance}}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding AdministrationMode, Mode=TwoWay}" />

                                    <StackLayout Grid.Column="9" Orientation="Horizontal" Spacing="4">
                                        <Button Text=""
                                    TextColor="Red"
                                    Command="{Binding BindingContext.DeleteMedicationWithPrescriptionCommand, Source={x:Reference MixedActIssuance}}"
                                    CommandParameter="{Binding .}"
                                    HeightRequest="20"
                                    WidthRequest="20"
                                    BackgroundColor="#faf6f6"
                                    ToolTipProperties.Text="terge medicament"/>
                                    </StackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>


            <!-- Medications Without Prescription -->
            <StackLayout Orientation="Horizontal" VerticalOptions="Center" Spacing="5"
             IsVisible="{Binding ShowWithoutPrescription}">
                <Label Text="Medicamente eliberate fr reet" FontAttributes="Bold" Margin="0,8,0,0" TextColor="#222" IsVisible="{Binding ShowWithoutPrescription}"/>
                <Button Text="+"
            Command="{Binding AddMedicationWithoutPrescriptionCommand}"
            IsVisible="{Binding ShowWithoutPrescription}"
            FontSize="16"
            HeightRequest="20"
            WidthRequest="20"
            MinimumHeightRequest="28"
            MinimumWidthRequest="28"
            CornerRadius="9"
            BackgroundColor="#ece8fa"
            TextColor="#34495E"
            Padding="0"
            VerticalOptions="Center" />
            </StackLayout>

            <Frame CornerRadius="8" BorderColor="#e8eaf1" Padding="6" BackgroundColor="White" IsVisible="{Binding ShowWithoutPrescription}">
                <VerticalStackLayout Spacing="6">
                    <CollectionView ItemsSource="{Binding MedicationsWithoutPrescription}" BackgroundColor="White">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="36,*,100,100,110,110,110,110,160,60">
                                <Label Grid.Column="0" Text="NR. CRT." FontAttributes="Bold" FontSize="12" TextColor="#34495E"/>
                                <Label Grid.Column="1" Text="MEDICAMENT" FontAttributes="Bold" FontSize="12" TextColor="#34495E"/>
                                <Label Grid.Column="2" Text="CANTITATE TOTAL" FontAttributes="Bold" FontSize="12" TextColor="#34495E"/>
                                <Label Grid.Column="3" Text="ZILE TRATAM." FontAttributes="Bold" FontSize="12" TextColor="#34495E"/>
                                <Label Grid.Column="4" Text="DIMINEAA" FontAttributes="Bold" FontSize="12" TextColor="#34495E"/>
                                <Label Grid.Column="5" Text="PRNZ" FontAttributes="Bold" FontSize="12" TextColor="#34495E"/>
                                <Label Grid.Column="6" Text="SEARA" FontAttributes="Bold" FontSize="12" TextColor="#34495E"/>
                                <Label Grid.Column="7" Text="NOAPTEA" FontAttributes="Bold" FontSize="12" TextColor="#34495E"/>
                                <Label Grid.Column="8" Text="MOD ADMINISTRARE" FontAttributes="Bold" FontSize="12" TextColor="#34495E"/>
                                <Label Text=" " />
                            </Grid>
                        </CollectionView.Header>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="36,*,100,100,110,110,110,110,160,60" Padding="2">
                                    <Label Grid.Column="0" Text="{Binding Index}" VerticalOptions="Center" HorizontalOptions="Center" TextColor="Black"/>

                                    <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Entry Text="{Binding Name}" Placeholder="Nume medicament" HorizontalOptions="FillAndExpand"/>
                                        <Button Text=""
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    BackgroundColor="Transparent"
                                    BorderColor="Transparent"
                                    BorderWidth="0"
                                    Padding="0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenMedicationPopupReceiptCommand}"
                                    CommandParameter="{Binding .}"/>
                                    </StackLayout>

                                    <Entry Grid.Column="2" Text="{Binding TotalQuantity, Mode=TwoWay}" Placeholder="Total" VerticalOptions="Center" HorizontalOptions="Center" TextColor="Black"/>
                                    <Entry Grid.Column="3" Text="{Binding TotalDays, Mode=TwoWay}" Placeholder="Nr. zile" VerticalOptions="Center" HorizontalOptions="Center" TextColor="Black"/>
                                    <Entry Grid.Column="4" Text="{Binding Morning}" Placeholder="Cantitate" Keyboard="Numeric" BackgroundColor="White"/>
                                    <Entry Grid.Column="5" Text="{Binding Noon}" Placeholder="Cantitate" Keyboard="Numeric" BackgroundColor="White"/>
                                    <Entry Grid.Column="6" Text="{Binding Evening}" Placeholder="Cantitate" Keyboard="Numeric" BackgroundColor="White"/>
                                    <Entry Grid.Column="7" Text="{Binding Night}" Placeholder="Cantitate" Keyboard="Numeric" BackgroundColor="White"/>

                                    <Picker Grid.Column="8"
                                TitleColor="LightGray"
                                ItemsSource="{Binding BindingContext.AdministrationModes, Source={x:Reference MixedActIssuance}}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding AdministrationMode, Mode=TwoWay}" />

                                    <StackLayout Grid.Column="9" Orientation="Horizontal" Spacing="4">
                                        <Button Text=""
                                    TextColor="Red"
                                    Command="{Binding BindingContext.DeleteMedicationWithoutPrescriptionCommand, Source={x:Reference MixedActIssuance}}"
                                    CommandParameter="{Binding .}"
                                    HeightRequest="20"
                                    WidthRequest="20"
                                    BackgroundColor="#faf6f6"
                                    ToolTipProperties.Text="terge medicament"/>
                                    </StackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>


            <Editor Placeholder="Stimate coleg, cu privire la pacientul/pacienta care s-a prezentat n farmacie v supun ateniei urmtoarele:"
                    Text="{Binding NotesToDoctor}" AutoSize="TextChanges" HeightRequest="56" BackgroundColor="White" />

            <Editor Placeholder="Recomandarea farmacistului (medicamentele sunt destinate doar persoanei pentru care au fost eliberate):"
                    Text="{Binding PharmacistRecommendation}" AutoSize="TextChanges" HeightRequest="56" BackgroundColor="White" />

            <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
                <Image Source="down_arrow.png" Margin="0,10,0,7" WidthRequest="20" HeightRequest="20" VerticalOptions="End"/>
                <Picker Title="Serviciu farmaceutic"
            ItemsSource="{Binding PharmaceuticalServices}"
            SelectedItem="{Binding SelectedPharmaceuticalService}" 
            WidthRequest="420"
            />
            </HorizontalStackLayout>

            <Grid Padding="0,8,0,0" VerticalOptions="Center" ColumnDefinitions="Auto, *, Auto">

                <!-- Coloana 0: Entry + Trimite Mail -->
                <HorizontalStackLayout Spacing="10" Grid.Column="0" VerticalOptions="Center">
                    <Entry Placeholder="Email pacient"
               Text="{Binding PatientEmail}"
               FontSize="14"
               WidthRequest="280"
               VerticalOptions="Center"/>
                    <Button Text="Trimite Mail"
                Command="{Binding SendEmailCommand}"
                FontSize="12"
                HeightRequest="34"
                CornerRadius="8"
                BackgroundColor="#007bff"
                TextColor="White"/>
                </HorizontalStackLayout>

                <!-- Coloana 1: spacer gol ocup tot restul spaiului -->
                <BoxView Grid.Column="1" Color="Transparent"/>

                <!-- Coloana 2: Printeaz + Salveaz -->
                <HorizontalStackLayout Spacing="10" Grid.Column="2" VerticalOptions="Center" Margin="0,0,20,10">
                    <Button Text="Printeaz"
                Command="{Binding PrintCommand}"
                FontSize="14"
                HeightRequest="34"
                CornerRadius="8"
                BackgroundColor="#f4f4f6"
                TextColor="#36317f"/>
                    <Button Text="Salveaz"
                Command="{Binding SaveCommand}"
                FontSize="14"
                HeightRequest="34"
                CornerRadius="8"
                BackgroundColor="Green"
                TextColor="White"/>
                </HorizontalStackLayout>

            </Grid>


        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
