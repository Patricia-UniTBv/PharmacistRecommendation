<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PharmacistRecommendation.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:PharmacistRecommendation.ViewModels"
    xmlns:helpers="clr-namespace:PharmacistRecommendation.Helpers"
    x:Class="PharmacistRecommendation.Views.MixedActIssuanceView"
    x:Name="MixedActIssuance">

    <ContentPage.Resources>
        <!-- Small circular "+" add button -->
        <Style x:Key="AddRowButton" TargetType="Button">
            <Setter Property="BackgroundColor"      Value="{StaticResource PrimaryContainer}"/>
            <Setter Property="TextColor"            Value="{StaticResource Primary}"/>
            <Setter Property="FontFamily"           Value="OpenSansSemiBold"/>
            <Setter Property="FontSize"             Value="16"/>
            <Setter Property="CornerRadius"         Value="9"/>
            <Setter Property="HeightRequest"        Value="28"/>
            <Setter Property="WidthRequest"         Value="28"/>
            <Setter Property="MinimumHeightRequest" Value="28"/>
            <Setter Property="MinimumWidthRequest"  Value="28"/>
            <Setter Property="Padding"              Value="0"/>
            <Setter Property="BorderWidth"          Value="0"/>
        </Style>

        <!-- Subtle delete button -->
        <Style x:Key="DeleteRowButton" TargetType="Button">
            <Setter Property="BackgroundColor"      Value="{StaticResource ErrorLight}"/>
            <Setter Property="TextColor"            Value="{StaticResource Error}"/>
            <Setter Property="FontSize"             Value="13"/>
            <Setter Property="CornerRadius"         Value="4"/>
            <Setter Property="HeightRequest"        Value="28"/>
            <Setter Property="WidthRequest"         Value="28"/>
            <Setter Property="MinimumHeightRequest" Value="28"/>
            <Setter Property="MinimumWidthRequest"  Value="28"/>
            <Setter Property="Padding"              Value="0"/>
            <Setter Property="BorderWidth"          Value="0"/>
        </Style>

        <Style x:Key="TableCard" TargetType="Border">
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeShape"     Value="RoundRectangle 8"/>
            <Setter Property="Stroke"          Value="{StaticResource BorderDefault}"/>
            <Setter Property="BackgroundColor" Value="{StaticResource Surface}"/>
            <Setter Property="Padding"         Value="6"/>
        </Style>

        <Style x:Key="ColumnHeader" TargetType="Label">
            <Setter Property="TextColor"   Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontFamily"  Value="OpenSansSemiBold"/>
            <Setter Property="FontSize"    Value="11"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="12,8" Spacing="6">

            <!-- Title bar -->
            <HorizontalStackLayout Spacing="10" Padding="0,0,0,6">
                <Label Text="{Binding PageTitle}"
                       Style="{StaticResource PageTitle}"
                       VerticalOptions="Center"
                       HorizontalOptions="StartAndExpand"/>
                <Button Text="Recomandare nouă"
                        Command="{Binding NewRecommendationCommand}"
                        Style="{StaticResource OutlineButton}"
                        FontSize="13"
                        HeightRequest="34"/>
                <Button Text="Import date"
                        Command="{Binding ImportDataCommand}"
                        FontSize="13"
                        HeightRequest="34"/>
            </HorizontalStackLayout>

            <!-- Patient info card -->
            <Border Style="{StaticResource TableCard}">
                <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Nr. card" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="8,0" HeightRequest="34">
                            <Entry Placeholder="Card nr." Text="{Binding CardNumber}" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Pacient" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="8,0" HeightRequest="34">
                            <Entry Placeholder="Pacient" Text="{Binding PatientName}" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2">
                        <Label Text="CNP/CID pacient" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="8,0" HeightRequest="34">
                            <Entry Placeholder="CNP/CID pacient" Text="{Binding PatientCnp}" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3">
                        <Label Text="Aparținător" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="8,0" HeightRequest="34">
                            <Entry Placeholder="Aparținător" Text="{Binding CaregiverName}" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="4">
                        <Label Text="CNP/CID aparținător" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="8,0" HeightRequest="34">
                            <Entry Placeholder="CNP/CID aparținător" Text="{Binding CaregiverCnp}" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Label Text="Diagnostic menționat de pacient/aparținător" Style="{StaticResource FieldLabel}"/>
            <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="10,0" HeightRequest="38">
                <Entry Placeholder="Diagnostic menționat de pacient/aparținător" Text="{Binding PatientDiagnosis}" BackgroundColor="Transparent" VerticalOptions="Center">
                    <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                </Entry>
            </Border>

            <!-- Medication search -->
            <VerticalStackLayout Padding="0,4">
                <Label Text="Medicamente utilizate de pacient" Style="{StaticResource FieldLabel}"/>
                <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="10,0" HeightRequest="38">
                    <Entry Text="{Binding SearchText}"
                           x:Name="SearchEntry"
                           Placeholder="Caută medicament..."
                           TextChanged="OnSearchTextChanged"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center">
                        <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                    </Entry>
                </Border>
                <CollectionView ItemsSource="{Binding Suggestions}"
                                SelectionMode="Single"
                                MaximumHeightRequest="100"
                                VerticalScrollBarVisibility="Always"
                                IsVisible="{Binding HasSuggestions}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding}" Padding="5">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddSuggestionCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Prescription info -->
            <Border Style="{StaticResource TableCard}" IsVisible="{Binding ShowWithPrescription}">
                <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto" ColumnSpacing="16">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Parafă medic" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="8,0" HeightRequest="34">
                            <Entry Placeholder="Parafă medic" Text="{Binding DoctorStamp}" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Seria" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="8,0" HeightRequest="34">
                            <Entry Placeholder="Seria" Text="{Binding PrescriptionSeries}" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                        <Label Text="Număr" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="8,0" HeightRequest="34">
                            <Entry Placeholder="Număr" Text="{Binding PrescriptionNumber}" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" Spacing="4">
                        <Label Text="Diagnostic" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="8,0" HeightRequest="34">
                            <Entry Placeholder="Diagnostic" Text="{Binding PrescriptionDiagnosis}" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Clinical observations -->
            <Border Style="{StaticResource TableCard}">
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto" ColumnSpacing="16">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Simptomatologie" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="8,0" HeightRequest="34">
                            <Entry Placeholder="Simptomatologie" Text="{Binding Symptoms}" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Suspiciune" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="8,0" HeightRequest="34">
                            <Entry Placeholder="Suspiciune" Text="{Binding Suspicion}" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                        <Label Text="Constatările farmacistului" Style="{StaticResource FieldLabel}"/>
                        <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="8,0" HeightRequest="34">
                            <Entry Placeholder="Constatările farmacistului" Text="{Binding PharmacistObservations}" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                            </Entry>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Medications with prescription -->
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center"
                                   IsVisible="{Binding ShowWithPrescription}">
                <Label Text="Medicamente eliberate cu rețetă"
                       Style="{StaticResource SectionTitle}"
                       VerticalOptions="Center"/>
                <Button Text="+"
                        Command="{Binding AddMedicationWithPrescriptionCommand}"
                        IsVisible="{Binding ShowWithPrescription}"
                        Style="{StaticResource AddRowButton}"
                        VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <Border Style="{StaticResource TableCard}" IsVisible="{Binding ShowWithPrescription}">
                <VerticalStackLayout Spacing="4">
                    <CollectionView ItemsSource="{Binding MedicationsWithPrescription}">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="36,*,100,100,110,110,110,110,160,60" Padding="2,0">
                                <Label Grid.Column="0" Text="NR." Style="{StaticResource ColumnHeader}"/>
                                <Label Grid.Column="1" Text="MEDICAMENT" Style="{StaticResource ColumnHeader}"/>
                                <Label Grid.Column="2" Text="CANT. TOTALĂ" Style="{StaticResource ColumnHeader}"/>
                                <Label Grid.Column="3" Text="ZILE TRATAM." Style="{StaticResource ColumnHeader}"/>
                                <Label Grid.Column="4" Text="DIMINEAȚĂ" Style="{StaticResource ColumnHeader}"/>
                                <Label Grid.Column="5" Text="PRÂNZ" Style="{StaticResource ColumnHeader}"/>
                                <Label Grid.Column="6" Text="SEARA" Style="{StaticResource ColumnHeader}"/>
                                <Label Grid.Column="7" Text="NOAPTEA" Style="{StaticResource ColumnHeader}"/>
                                <Label Grid.Column="8" Text="MOD ADMINISTRARE" Style="{StaticResource ColumnHeader}"/>
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="36,*,100,100,110,110,110,110,160,60" Padding="2">
                                    <Label Grid.Column="0" Text="{Binding Index}" VerticalOptions="Center" HorizontalOptions="Center"/>
                                    <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Entry Text="{Binding Name}" Placeholder="Nume medicament" HorizontalOptions="FillAndExpand"/>
                                        <Button Text="Caută" WidthRequest="60" HeightRequest="36"
                                                Style="{StaticResource OutlineButton}" FontSize="11" Padding="4,0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenMedicationPopupCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </StackLayout>
                                    <Entry Grid.Column="2" Text="{Binding TotalQuantity, Mode=TwoWay}" Placeholder="Total" VerticalOptions="Center" HorizontalOptions="Center"/>
                                    <Entry Grid.Column="3" Text="{Binding TotalDays, Mode=TwoWay}" Placeholder="Nr. zile" VerticalOptions="Center" HorizontalOptions="Center"/>
                                    <Entry Grid.Column="4" Text="{Binding Morning}" Placeholder="Cantitate" Keyboard="Numeric"/>
                                    <Entry Grid.Column="5" Text="{Binding Noon}" Placeholder="Cantitate" Keyboard="Numeric"/>
                                    <Entry Grid.Column="6" Text="{Binding Evening}" Placeholder="Cantitate" Keyboard="Numeric"/>
                                    <Entry Grid.Column="7" Text="{Binding Night}" Placeholder="Cantitate" Keyboard="Numeric"/>
                                    <Picker Grid.Column="8"
                                            ItemsSource="{Binding BindingContext.AdministrationModes, Source={x:Reference MixedActIssuance}}"
                                            ItemDisplayBinding="{Binding Name}"
                                            SelectedItem="{Binding AdministrationMode, Mode=TwoWay}"/>
                                    <Button Grid.Column="9" Text="×" Style="{StaticResource DeleteRowButton}"
                                            Command="{Binding BindingContext.DeleteMedicationWithPrescriptionCommand, Source={x:Reference MixedActIssuance}}"
                                            CommandParameter="{Binding .}"
                                            ToolTipProperties.Text="Șterge medicament"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Medications without prescription -->
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center"
                                   IsVisible="{Binding ShowWithoutPrescription}">
                <Label Text="Medicamente eliberate fără rețetă"
                       Style="{StaticResource SectionTitle}"
                       VerticalOptions="Center"/>
                <Button Text="+"
                        Command="{Binding AddMedicationWithoutPrescriptionCommand}"
                        IsVisible="{Binding ShowWithoutPrescription}"
                        Style="{StaticResource AddRowButton}"
                        VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <Border Style="{StaticResource TableCard}" IsVisible="{Binding ShowWithoutPrescription}">
                <VerticalStackLayout Spacing="4">
                    <CollectionView ItemsSource="{Binding MedicationsWithoutPrescription}">
                        <CollectionView.Header>
                            <Grid ColumnDefinitions="36,*,100,100,110,110,110,110,160,60" Padding="2,0">
                                <Label Grid.Column="0" Text="NR." Style="{StaticResource ColumnHeader}"/>
                                <Label Grid.Column="1" Text="MEDICAMENT" Style="{StaticResource ColumnHeader}"/>
                                <Label Grid.Column="2" Text="CANT. TOTALĂ" Style="{StaticResource ColumnHeader}"/>
                                <Label Grid.Column="3" Text="ZILE TRATAM." Style="{StaticResource ColumnHeader}"/>
                                <Label Grid.Column="4" Text="DIMINEAȚĂ" Style="{StaticResource ColumnHeader}"/>
                                <Label Grid.Column="5" Text="PRÂNZ" Style="{StaticResource ColumnHeader}"/>
                                <Label Grid.Column="6" Text="SEARA" Style="{StaticResource ColumnHeader}"/>
                                <Label Grid.Column="7" Text="NOAPTEA" Style="{StaticResource ColumnHeader}"/>
                                <Label Grid.Column="8" Text="MOD ADMINISTRARE" Style="{StaticResource ColumnHeader}"/>
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="36,*,100,100,110,110,110,110,160,60" Padding="2">
                                    <Label Grid.Column="0" Text="{Binding Index}" VerticalOptions="Center" HorizontalOptions="Center"/>
                                    <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Entry Text="{Binding Name}" Placeholder="Nume medicament" HorizontalOptions="FillAndExpand"/>
                                        <Button Text="Caută" WidthRequest="60" HeightRequest="36"
                                                Style="{StaticResource OutlineButton}" FontSize="11" Padding="4,0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenMedicationPopupReceiptCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </StackLayout>
                                    <Entry Grid.Column="2" Text="{Binding TotalQuantity, Mode=TwoWay}" Placeholder="Total" VerticalOptions="Center" HorizontalOptions="Center"/>
                                    <Entry Grid.Column="3" Text="{Binding TotalDays, Mode=TwoWay}" Placeholder="Nr. zile" VerticalOptions="Center" HorizontalOptions="Center"/>
                                    <Entry Grid.Column="4" Text="{Binding Morning}" Placeholder="Cantitate" Keyboard="Numeric"/>
                                    <Entry Grid.Column="5" Text="{Binding Noon}" Placeholder="Cantitate" Keyboard="Numeric"/>
                                    <Entry Grid.Column="6" Text="{Binding Evening}" Placeholder="Cantitate" Keyboard="Numeric"/>
                                    <Entry Grid.Column="7" Text="{Binding Night}" Placeholder="Cantitate" Keyboard="Numeric"/>
                                    <Picker Grid.Column="8"
                                            ItemsSource="{Binding BindingContext.AdministrationModes, Source={x:Reference MixedActIssuance}}"
                                            ItemDisplayBinding="{Binding Name}"
                                            SelectedItem="{Binding AdministrationMode, Mode=TwoWay}"/>
                                    <Button Grid.Column="9" Text="×" Style="{StaticResource DeleteRowButton}"
                                            Command="{Binding BindingContext.DeleteMedicationWithoutPrescriptionCommand, Source={x:Reference MixedActIssuance}}"
                                            CommandParameter="{Binding .}"
                                            ToolTipProperties.Text="Șterge medicament"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Editor Placeholder="Stimate coleg, cu privire la pacientul/pacienta care s-a prezentat în farmacie vă supun atenției următoarele:"
                    Text="{Binding NotesToDoctor}" AutoSize="TextChanges" HeightRequest="56"/>

            <Editor Placeholder="Recomandarea farmacistului (medicamentele sunt destinate doar persoanei pentru care au fost eliberate):"
                    Text="{Binding PharmacistRecommendation}" AutoSize="TextChanges" HeightRequest="56"/>

            <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
                <Image Source="down_arrow.png" Margin="0,10,0,7" WidthRequest="20" HeightRequest="20" VerticalOptions="End"/>
                <Picker Title="Serviciu farmaceutic"
                        ItemsSource="{Binding PharmaceuticalServices}"
                        SelectedItem="{Binding SelectedPharmaceuticalService}"
                        WidthRequest="420"/>
            </HorizontalStackLayout>

            <!-- Bottom action bar -->
            <Grid Padding="0,8,0,4" VerticalOptions="Center" ColumnDefinitions="Auto,*,Auto">
                <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                    <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="10,0" HeightRequest="38" WidthRequest="280">
                        <Entry Placeholder="Email pacient"
                               Text="{Binding PatientEmail}"
                               FontSize="14"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center">
                            <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                        </Entry>
                    </Border>
                    <Button Text="Trimite Mail"
                            Command="{Binding SendEmailCommand}"
                            FontSize="12"/>
                </HorizontalStackLayout>

                <BoxView Grid.Column="1" Color="Transparent"/>

                <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center" Margin="0,0,8,0">
                    <Button Text="Tipărește"
                            Command="{Binding PrintCommand}"
                            Style="{StaticResource OutlineButton}"
                            FontSize="13"/>
                    <Button Text="Salvează"
                            Command="{Binding SaveCommand}"
                            FontSize="13"
                            IsVisible="{Binding IsSaveButtonVisible}"/>
                </HorizontalStackLayout>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
