<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PharmacistRecommendation.Views.MainPageView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeShape"     Value="RoundRectangle 10"/>
            <Setter Property="Stroke"          Value="{StaticResource BorderDefault}"/>
            <Setter Property="BackgroundColor" Value="{StaticResource Surface}"/>
            <Setter Property="Padding"         Value="20"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="BackgroundColor"      Value="{StaticResource Primary}"/>
            <Setter Property="TextColor"            Value="{StaticResource TextOnPrimary}"/>
            <Setter Property="FontFamily"           Value="OpenSansSemiBold"/>
            <Setter Property="FontSize"             Value="14"/>
            <Setter Property="CornerRadius"         Value="8"/>
            <Setter Property="HeightRequest"        Value="60"/>
            <Setter Property="BorderWidth"          Value="0"/>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLight}"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryDark}"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout HorizontalOptions="Center"
                             MaximumWidthRequest="760"
                             Padding="32,28"
                             Spacing="20">

            <!-- Header card -->
            <Border Style="{StaticResource SectionCard}">
                <HorizontalStackLayout Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="logo.png"
                           WidthRequest="52"
                           HeightRequest="52"
                           Aspect="AspectFit"
                           VerticalOptions="Center"/>
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Label Text="Recomandarea Farmacistului"
                               Style="{StaticResource PageTitle}"
                               HorizontalOptions="Start"/>
                        <Label Text="Selectați modulul dorit din opțiunile de mai jos"
                               Style="{StaticResource CaptionLabel}"
                               HorizontalOptions="Start"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!-- Funcții principale -->
            <Border Style="{StaticResource SectionCard}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Funcții principale" Style="{StaticResource SectionTitle}"/>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" Margin="0,0,0,4"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0"
                                Style="{StaticResource NavButton}"
                                Text="Monitorizare"
                                Command="{Binding NavigateToMonitoringCommand}"/>
                        <Button Grid.Column="1"
                                Style="{StaticResource NavButton}"
                                Text="Card Nou"
                                Command="{Binding NavigateToNewCardCommand}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Emitere documente -->
            <Border Style="{StaticResource SectionCard}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Emitere documente" Style="{StaticResource SectionTitle}"/>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" Margin="0,0,0,4"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0"
                                Style="{StaticResource NavButton}"
                                Text="Act cu Prescripție"
                                Command="{Binding NavigateToPrescriptionOnlyCommand}"/>
                        <Button Grid.Column="1"
                                Style="{StaticResource NavButton}"
                                Text="Act Farmaceutic"
                                Command="{Binding NavigateToWithoutPrescriptionCommand}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
