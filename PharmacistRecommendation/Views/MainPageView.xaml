<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PharmacistRecommendation.Views.MainPageView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeShape"     Value="RoundRectangle 10"/>
            <Setter Property="Stroke"          Value="{StaticResource BorderDefault}"/>
            <Setter Property="BackgroundColor" Value="{StaticResource Surface}"/>
            <Setter Property="Padding"         Value="20"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="BackgroundColor"      Value="{StaticResource Primary}"/>
            <Setter Property="TextColor"            Value="{StaticResource TextOnPrimary}"/>
            <Setter Property="FontFamily"           Value="OpenSansSemiBold"/>
            <Setter Property="FontSize"             Value="14"/>
            <Setter Property="CornerRadius"         Value="8"/>
            <Setter Property="HeightRequest"        Value="60"/>
            <Setter Property="BorderWidth"          Value="0"/>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLight}"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryDark}"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="ConfigButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceVariant}"/>
            <Setter Property="TextColor"       Value="{StaticResource TextPrimary}"/>
            <Setter Property="HeightRequest"   Value="50"/>
            <Setter Property="FontSize"        Value="13"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout HorizontalOptions="Fill"
                             Padding="48,28"
                             Spacing="16">

            <!-- Header card — full width -->
            <Border Style="{StaticResource SectionCard}">
                <HorizontalStackLayout Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="logo.png"
                           WidthRequest="52"
                           HeightRequest="52"
                           Aspect="AspectFit"
                           VerticalOptions="Center"/>
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Label Text="Recomandarea Farmacistului"
                               Style="{StaticResource PageTitle}"
                               HorizontalOptions="Start"/>
                        <Label Text="Selectați modulul dorit din opțiunile de mai jos"
                               Style="{StaticResource CaptionLabel}"
                               HorizontalOptions="Start"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!-- Two-column row: Funcții principale | Emitere documente -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

                <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Funcții principale" Style="{StaticResource SectionTitle}"/>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" Margin="0,0,0,4"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Grid.Column="0"
                                    Style="{StaticResource NavButton}"
                                    Text="Monitorizare"
                                    Command="{Binding NavigateToMonitoringCommand}"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource NavButton}"
                                    Text="Card Nou"
                                    Command="{Binding NavigateToNewCardCommand}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Emitere documente" Style="{StaticResource SectionTitle}"/>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" Margin="0,0,0,4"/>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <Button Grid.Column="0"
                                    Style="{StaticResource NavButton}"
                                    Text="Act cu Prescripție"
                                    Command="{Binding NavigateToPrescriptionOnlyCommand}"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource NavButton}"
                                    Text="Act Farmaceutic"
                                    Command="{Binding NavigateToWithoutPrescriptionCommand}"/>
                            <Button Grid.Column="2"
                                    Style="{StaticResource NavButton}"
                                    Text="Act Mixt"
                                    Command="{Binding NavigateToMixedIssuanceCommand}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- Two-column row: Rapoarte | Gestionare utilizatori -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

                <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Rapoarte" Style="{StaticResource SectionTitle}"/>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" Margin="0,0,0,4"/>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <Button Grid.Column="0"
                                    Style="{StaticResource NavButton}"
                                    Text="Acte Proprii"
                                    Command="{Binding NavigateToOwnActsReportCommand}"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource NavButton}"
                                    Text="Acte Consecutive"
                                    Command="{Binding NavigateToConsecutiveActsReportCommand}"/>
                            <Button Grid.Column="2"
                                    Style="{StaticResource NavButton}"
                                    Text="Centru Rapoarte"
                                    Command="{Binding NavigateToReportsCommand}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Gestionare utilizatori" Style="{StaticResource SectionTitle}"/>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" Margin="0,0,0,4"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Grid.Column="0"
                                    Style="{StaticResource NavButton}"
                                    Text="Utilizatori"
                                    Command="{Binding NavigateToUsersManagementCommand}"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource NavButton}"
                                    Text="Medicamente"
                                    Command="{Binding NavigateToMedicationsCommand}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- Configurare — full width, all 5 buttons in one row -->
            <Border Style="{StaticResource SectionCard}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Configurare" Style="{StaticResource SectionTitle}"/>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Separator}" Margin="0,0,0,4"/>
                    <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
                        <Button Grid.Column="0"
                                Style="{StaticResource ConfigButton}"
                                Text="Moduri administrare"
                                Command="{Binding NavigateToAdministrationModesCommand}"/>
                        <Button Grid.Column="1"
                                Style="{StaticResource ConfigButton}"
                                Text="Configurare email"
                                Command="{Binding NavigateToEmailCommand}"/>
                        <Button Grid.Column="2"
                                Style="{StaticResource ConfigButton}"
                                Text="Configurare importuri"
                                Command="{Binding NavigateToImportConfigCommand}"/>
                        <Button Grid.Column="3"
                                Style="{StaticResource ConfigButton}"
                                Text="Document GDPR"
                                Command="{Binding NavigateToGdprConfigCommand}"/>
                        <Button Grid.Column="4"
                                Style="{StaticResource ConfigButton}"
                                Text="Conexiune server"
                                Command="{Binding NavigateToServerConfigCommand}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
