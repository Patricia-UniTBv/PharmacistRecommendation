<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PharmacistRecommendation.Views.AddEditMedicationView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PharmacistRecommendation.ViewModels"
             x:DataType="viewmodels:AddEditMedicationViewModel"
             Title="{Binding PageTitle}"
             BackgroundColor="{StaticResource Background}">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="4">

            <!-- Basic information -->
            <Label Text="Informații de Bază"
                   FontFamily="OpenSansSemiBold" FontSize="13"
                   TextColor="{StaticResource TextPrimary}"
                   BackgroundColor="{StaticResource PrimaryContainer}"
                   Padding="10,6" Margin="0,12,0,6"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="COD CIM *" Style="{StaticResource FieldLabel}"/>
                    <Entry Text="{Binding CodCIM}" Placeholder="W12345" MaxLength="50"/>
                    <Label Text="{Binding CodCIMError}" TextColor="{StaticResource Error}"
                           FontSize="10" IsVisible="{Binding HasCodCIMError}"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="COD ATC" Style="{StaticResource FieldLabel}"/>
                    <Entry Text="{Binding CodATC}" Placeholder="A01AB02" MaxLength="7"/>
                    <Label Text="{Binding CodATCError}" TextColor="{StaticResource Error}"
                           FontSize="10" IsVisible="{Binding HasCodATCError}"/>
                </VerticalStackLayout>
            </Grid>

            <Label Text="DENUMIRE COMERCIALĂ *" Style="{StaticResource FieldLabel}"/>
            <Entry Text="{Binding Denumire}" Placeholder="Aspirin 100mg"/>
            <Label Text="{Binding DenumireError}" TextColor="{StaticResource Error}"
                   FontSize="10" IsVisible="{Binding HasDenumireError}"/>

            <Label Text="DCI" Style="{StaticResource FieldLabel}"/>
            <Entry Text="{Binding DCI}" Placeholder="Acetylsalicylic acid"/>

            <Label Text="ACȚIUNE TERAPEUTICĂ" Style="{StaticResource FieldLabel}"/>
            <Entry Text="{Binding ActiuneTerapeutica}" Placeholder="Antiinflamator, analgezic"/>

            <Label Text="PRESCRIPȚIE" Style="{StaticResource FieldLabel}"/>
            <Entry Text="{Binding Prescriptie}" Placeholder="Cu prescripție medicală"/>

            <!-- Company information -->
            <Label Text="Informații Producător"
                   FontFamily="OpenSansSemiBold" FontSize="13"
                   TextColor="{StaticResource TextPrimary}"
                   BackgroundColor="{StaticResource PrimaryContainer}"
                   Padding="10,6" Margin="0,12,0,6"/>

            <Label Text="FIRMA PRODUCĂTOARE" Style="{StaticResource FieldLabel}"/>
            <Entry Text="{Binding FirmaProducatoare}" Placeholder="Bayer AG"/>

            <Label Text="FIRMA DEȚINĂTOARE" Style="{StaticResource FieldLabel}"/>
            <Entry Text="{Binding FirmaDetinatoare}" Placeholder="Bayer Romania"/>

            <!-- Packaging information -->
            <Label Text="Informații Ambalaj"
                   FontFamily="OpenSansSemiBold" FontSize="13"
                   TextColor="{StaticResource TextPrimary}"
                   BackgroundColor="{StaticResource PrimaryContainer}"
                   Padding="10,6" Margin="0,12,0,6"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="NR/DATA AMBALAJ" Style="{StaticResource FieldLabel}"/>
                    <Entry Text="{Binding NrData}" Placeholder="123/2024"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="VOLUM AMBALAJ" Style="{StaticResource FieldLabel}"/>
                    <Entry Text="{Binding VolumAmbalaj}" Placeholder="30 comprimate"/>
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="AMBALAJ" Style="{StaticResource FieldLabel}"/>
                    <Entry Text="{Binding Ambalaj}" Placeholder="Blister"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="VALABILITATE" Style="{StaticResource FieldLabel}"/>
                    <Entry Text="{Binding Valabilitate}" Placeholder="24 luni"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Regulatory symbols -->
            <Label Text="Simboluri Reglementare"
                   FontFamily="OpenSansSemiBold" FontSize="13"
                   TextColor="{StaticResource TextPrimary}"
                   BackgroundColor="{StaticResource PrimaryContainer}"
                   Padding="10,6" Margin="0,12,0,6"/>

            <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,4,0,0">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                    <Label Text="Bulină" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                    <CheckBox IsChecked="{Binding HasBulina}" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                    <Label Text="Diez" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                    <CheckBox IsChecked="{Binding HasDiez}" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                    <Label Text="Stea" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                    <CheckBox IsChecked="{Binding HasStea}" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="4">
                    <Label Text="Triunghi" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                    <CheckBox IsChecked="{Binding HasTriunghi}" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="4">
                    <Label Text="Dreptunghi" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                    <CheckBox IsChecked="{Binding HasDreptunghi}" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Action buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,20,0,0">
                <Button Grid.Column="0" Text="Anulează"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource OutlineButton}"/>
                <Button Grid.Column="1" Text="{Binding SaveButtonText}"
                        Command="{Binding SaveCommand}"/>
            </Grid>

            <VerticalStackLayout IsVisible="{Binding IsLoading}" HorizontalOptions="Center" Margin="0,16,0,0">
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   Color="{StaticResource Primary}"
                                   WidthRequest="30" HeightRequest="30"/>
                <Label Text="{Binding LoadingMessage}"
                       TextColor="{StaticResource TextSecondary}"
                       FontSize="12"
                       HorizontalOptions="Center"
                       Margin="0,6,0,0"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
