<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="PharmacistRecommendation.Views.PharmacistConfigurationView"
    CanBeDismissedByTappingOutsideOfPopup="False"
    Color="#66000000">

    <Border BackgroundColor="{StaticResource Surface}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 12"
            Padding="24,24,24,16"
            WidthRequest="500"
            HeightRequest="520"
            HorizontalOptions="Center"
            VerticalOptions="Center">

        <Grid RowDefinitions="Auto,*,Auto">

            <Label Grid.Row="0"
                   Text="Configurare farmacist/asistent"
                   Style="{StaticResource PageTitle}"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,16"/>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="6">
                    <Entry Placeholder="Nume"                  Text="{Binding LastName}"/>
                    <Entry Placeholder="Prenume"               Text="{Binding FirstName}"/>
                    <Entry Placeholder="Username"              Text="{Binding Username}"/>
                    <Entry Placeholder="NCM (serie și număr)"  Text="{Binding Ncm}"/>
                    <Entry Placeholder="Email"                 Text="{Binding Email}"   Keyboard="Email"/>
                    <Entry Placeholder="Telefon"               Text="{Binding PhoneNr}" Keyboard="Telephone"/>

                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding IsAssistant, Mode=TwoWay}"/>
                        <Label Text="Este asistent/ă" VerticalOptions="Center" TextColor="{StaticResource TextPrimary}"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="8">
                        <Entry x:Name="PasswordEntry"
                               Text="{Binding Password}"
                               IsPassword="{Binding IsPassword, Mode=TwoWay}"
                               Placeholder="Parolă"
                               WidthRequest="260"/>
                        <ImageButton Source="view.png"
                                     Clicked="OnShowPasswordClicked"
                                     BackgroundColor="Transparent"
                                     WidthRequest="20" HeightRequest="20"
                                     Aspect="AspectFit"
                                     Padding="0"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <HorizontalStackLayout Grid.Row="2"
                                   Spacing="12"
                                   Margin="0,12,0,0"
                                   HorizontalOptions="End">
                <Button Text="Salvează"  Command="{Binding SaveCommand}"/>
                <Button Text="Închide"   Command="{Binding CancelCommand}" Style="{StaticResource OutlineButton}"/>
            </HorizontalStackLayout>

        </Grid>
    </Border>
</toolkit:Popup>
