<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PharmacistRecommendation.Views.MonitoringView">

    <ContentPage.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeShape"     Value="RoundRectangle 8"/>
            <Setter Property="Stroke"          Value="{StaticResource BorderDefault}"/>
            <Setter Property="BackgroundColor" Value="{StaticResource Surface}"/>
            <Setter Property="Padding"         Value="12"/>
        </Style>
        <Style x:Key="FieldBorder" TargetType="Border">
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeShape"     Value="RoundRectangle 4"/>
            <Setter Property="Stroke"          Value="{StaticResource BorderDefault}"/>
            <Setter Property="HeightRequest"   Value="34"/>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="15" Spacing="8">

                <Label Text="Monitorizare pacient"
                       Style="{StaticResource PageTitle}"
                       HorizontalOptions="Center"
                       Margin="0,0,0,4"/>

                <!-- Patient info -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Date pacient" Style="{StaticResource SectionTitle}"/>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Număr card" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding CardNumber}" BackgroundColor="Transparent" FontSize="11"/>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="CNP" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding Cnp}" BackgroundColor="Transparent" FontSize="11"/>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="CID" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding Cid}" BackgroundColor="Transparent" FontSize="11"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="0.7*"/>
                            </Grid.ColumnDefinitions>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Nume" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding LastName}" BackgroundColor="Transparent" FontSize="11"/>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Prenume" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding FirstName}" BackgroundColor="Transparent" FontSize="11"/>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="Vârstă" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding Age}" Keyboard="Numeric" BackgroundColor="Transparent" FontSize="11"/>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="3" Spacing="2">
                                <Label Text="Gen" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource FieldBorder}">
                                    <Picker SelectedItem="{Binding Gender}" BackgroundColor="Transparent" FontSize="11">
                                        <Picker.Items>
                                            <x:String>Feminin</x:String>
                                            <x:String>Masculin</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Monitored parameters -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Parametri monitorizați" Style="{StaticResource SectionTitle}"/>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Greutate (kg)" Style="{StaticResource FieldLabel}"/>
                                <Entry Text="{Binding Weight}" Keyboard="Numeric" FontSize="11" HeightRequest="25"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Înălțime (cm)" Style="{StaticResource FieldLabel}"/>
                                <Entry Text="{Binding Height}" Keyboard="Numeric" FontSize="11" HeightRequest="25"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="TA Sistolic" Style="{StaticResource FieldLabel}"/>
                                <Entry Text="{Binding MaxBloodPressure}" Keyboard="Numeric" FontSize="11" HeightRequest="25"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="TA Diastolic" Style="{StaticResource FieldLabel}"/>
                                <Entry Text="{Binding MinBloodPressure}" Keyboard="Numeric" FontSize="11" HeightRequest="25"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="Puls (bpm)" Style="{StaticResource FieldLabel}"/>
                                <Entry Text="{Binding HeartRate}" Keyboard="Numeric" FontSize="11" HeightRequest="25"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Pulsoximetrie (%)" Style="{StaticResource FieldLabel}"/>
                                <Entry Text="{Binding PulseOximetry}" Keyboard="Numeric" FontSize="11" HeightRequest="25"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Glicemie (mg/dL)" Style="{StaticResource FieldLabel}"/>
                                <Entry Text="{Binding BloodGlucose}" Keyboard="Numeric" FontSize="11" HeightRequest="25"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="Temperatură (°C)" Style="{StaticResource FieldLabel}"/>
                                <Entry Text="{Binding BodyTemperature}" Keyboard="Numeric" FontSize="11" HeightRequest="25"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- History -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Text="Istoric" Style="{StaticResource SectionTitle}"/>
                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Label Text="De la:" FontSize="12" VerticalOptions="Center"/>
                                <DatePicker Date="{Binding StartDate}" Format="dd/MM/yy" FontSize="12" Margin="0,5,0,0"/>
                                <Label Text="Până la:" FontSize="12" VerticalOptions="Center"/>
                                <DatePicker Date="{Binding EndDate}" Format="dd/MM/yy" FontSize="12" Margin="0,5,0,0"/>
                                <Button Text="Caută"
                                        Command="{Binding LoadHistoryCommand}"
                                        FontSize="11"
                                        Padding="10,4"
                                        HeightRequest="30"
                                        WidthRequest="68"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Table header -->
                        <Grid Padding="2,4" BackgroundColor="{StaticResource SurfaceVariant}" ColumnSpacing="35">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <Label Text="Data"        Grid.Column="0" FontFamily="OpenSansSemiBold" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
                            <Label Text="TA Sist."    Grid.Column="1" FontFamily="OpenSansSemiBold" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
                            <Label Text="TA Diast."   Grid.Column="2" FontFamily="OpenSansSemiBold" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
                            <Label Text="Puls"        Grid.Column="3" FontFamily="OpenSansSemiBold" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
                            <Label Text="SpO₂"        Grid.Column="4" FontFamily="OpenSansSemiBold" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
                            <Label Text="Glicemie"    Grid.Column="5" FontFamily="OpenSansSemiBold" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
                            <Label Text="Temp."       Grid.Column="6" FontFamily="OpenSansSemiBold" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
                            <Label Text="Greutate"    Grid.Column="7" FontFamily="OpenSansSemiBold" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
                            <Label Text="Înălțime"    Grid.Column="8" FontFamily="OpenSansSemiBold" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
                        </Grid>

                        <ScrollView>
                            <CollectionView ItemsSource="{Binding HistoryList}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4" ColumnSpacing="35">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Text="{Binding Date, StringFormat='{0:dd.MM.yy}'}" Grid.Column="0" FontSize="12" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding MaxBloodPressure}"  Grid.Column="1" FontSize="12" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding MinBloodPressure}"  Grid.Column="2" FontSize="12" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding HeartRate}"         Grid.Column="3" FontSize="12" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding PulseOximetry}"     Grid.Column="4" FontSize="12" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding BloodGlucose}"      Grid.Column="5" FontSize="12" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding BodyTemperature}"   Grid.Column="6" FontSize="12" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding Weight}"            Grid.Column="7" FontSize="12" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding Height}"            Grid.Column="8" FontSize="12" HorizontalTextAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Footer action bar -->
        <Border Grid.Row="1"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                Stroke="{StaticResource BorderDefault}"
                BackgroundColor="{StaticResource Surface}"
                Padding="14,10"
                Margin="15,0,15,12">
            <Grid ColumnSpacing="10" VerticalOptions="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Text="Email pacient:" Grid.Column="0" VerticalOptions="Center" FontSize="12"/>
                <Entry Text="{Binding PatientEmail}" Grid.Column="1"
                       Placeholder="ex: ion.popescu@mail.com" Keyboard="Email" FontSize="12" HeightRequest="35"/>
                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                    <Button Text="Trimite Mail"  Command="{Binding SendEmailCommand}"
                            Style="{StaticResource OutlineButton}" FontSize="12" HeightRequest="34" WidthRequest="100"/>
                    <Button Text="Tipărește"     Command="{Binding GeneratePdfCommand}"
                            Style="{StaticResource OutlineButton}" FontSize="12" HeightRequest="34" WidthRequest="80"/>
                    <Button Text="Resetează"     Command="{Binding ClearCommand}"
                            IsVisible="{Binding IsSaveButtonVisible}"
                            Style="{StaticResource OutlineButton}" FontSize="12" HeightRequest="34" WidthRequest="80"/>
                    <Button Text="Salvează"      Command="{Binding SaveCommand}"
                            IsVisible="{Binding IsSaveButtonVisible}"
                            FontSize="12" HeightRequest="34" WidthRequest="80"/>
                </HorizontalStackLayout>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
