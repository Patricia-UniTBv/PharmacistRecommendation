<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PharmacistRecommendation.Views.LoginAddUserView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PharmacistRecommendation.ViewModels"
             xmlns:helpers="clr-namespace:PharmacistRecommendation.Helpers"
             x:DataType="vm:LoginAddUserViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource NavyHeader}">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             MinimumHeightRequest="600"
                             Padding="24,48">

            <!-- Card -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Background="{StaticResource SurfaceBrush}"
                    Padding="0"
                    WidthRequest="440"
                    HorizontalOptions="Center">

                <VerticalStackLayout Spacing="0">

                    <!-- Card header: logo + title -->
                    <VerticalStackLayout Spacing="8"
                                         Padding="36,28,36,20">
                        <Image Source="logo.png"
                               WidthRequest="64"
                               HeightRequest="64"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"/>
                        <Label Text="Recomandarea Farmacistului"
                               FontFamily="OpenSansSemiBold"
                               FontSize="17"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <!-- Divider -->
                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource Separator}"
                             Margin="0,0,0,0"/>

                    <!-- Tab toggle -->
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="0"
                          Margin="24,20,24,0">

                        <!-- Login tab -->
                        <Border Grid.Column="0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6,0,0,6"
                                Padding="0"
                                HeightRequest="38">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsLoginMode}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="Stroke"     Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsLoginMode}" Value="False">
                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                    <Setter Property="Stroke"     Value="{StaticResource BorderBrush}"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Button Text="Autentificare"
                                    BackgroundColor="Transparent"
                                    FontFamily="OpenSansSemiBold"
                                    FontSize="13"
                                    BorderWidth="0"
                                    HeightRequest="38"
                                    Command="{Binding ShowLoginCommand}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsLoginMode}" Value="True">
                                        <Setter Property="TextColor" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsLoginMode}" Value="False">
                                        <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Border>

                        <!-- Add user tab -->
                        <Border Grid.Column="1"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 0,6,6,0"
                                Padding="0"
                                HeightRequest="38">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsLoginMode}" Value="False">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="Stroke"     Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsLoginMode}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                    <Setter Property="Stroke"     Value="{StaticResource BorderBrush}"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Button Text="Utilizator nou"
                                    BackgroundColor="Transparent"
                                    FontFamily="OpenSansSemiBold"
                                    FontSize="13"
                                    BorderWidth="0"
                                    HeightRequest="38"
                                    Command="{Binding ShowAddUserCommand}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsLoginMode}" Value="False">
                                        <Setter Property="TextColor" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsLoginMode}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Border>
                    </Grid>

                    <!-- ── LOGIN FORM ── -->
                    <VerticalStackLayout Spacing="14"
                                         IsVisible="{Binding IsLoginMode}"
                                         Padding="24,20,24,28">

                        <!-- Username -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="NUME UTILIZATOR" Style="{StaticResource FieldLabel}"/>
                            <Border Stroke="{StaticResource BorderDefault}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 6"
                                    Background="{StaticResource SurfaceBrush}"
                                    Padding="12,0"
                                    HeightRequest="40">
                                <Entry Text="{Binding LoginUsername}"
                                       Placeholder="Introduceți username-ul"
                                       BackgroundColor="Transparent"
                                       VerticalOptions="Center"
                                       ReturnType="Next">
                                    <Entry.Behaviors>
                                        <helpers:FocusBorderBehavior/>
                                    </Entry.Behaviors>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Password -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="PAROLĂ" Style="{StaticResource FieldLabel}"/>
                            <Border Stroke="{StaticResource BorderDefault}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 6"
                                    Background="{StaticResource SurfaceBrush}"
                                    Padding="12,0"
                                    HeightRequest="40">
                                <Entry Text="{Binding LoginPassword}"
                                       Placeholder="Introduceți parola"
                                       IsPassword="True"
                                       BackgroundColor="Transparent"
                                       VerticalOptions="Center"
                                       ReturnType="Done"
                                       ReturnCommand="{Binding LoginCommand}">
                                    <Entry.Behaviors>
                                        <helpers:FocusBorderBehavior/>
                                    </Entry.Behaviors>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Error -->
                        <Label Text="{Binding LoginErrorMessage}"
                               TextColor="{StaticResource Error}"
                               FontSize="12"
                               IsVisible="{Binding HasLoginError}"
                               HorizontalOptions="Center"/>

                        <!-- Login button -->
                        <Button Text="Autentificare"
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding IsNotLoginLoading}"
                                HeightRequest="42"
                                Margin="0,4,0,0"/>

                        <ActivityIndicator IsRunning="{Binding IsLoginLoading}"
                                           IsVisible="{Binding IsLoginLoading}"
                                           Color="{StaticResource Primary}"
                                           HorizontalOptions="Center"/>

                        <Button Text="Ai uitat parola?"
                                Command="{Binding ForgotPasswordCommand}"
                                Style="{StaticResource GhostButton}"
                                HorizontalOptions="Center"
                                FontSize="12"/>
                    </VerticalStackLayout>

                    <!-- ── ADD USER FORM ── -->
                    <VerticalStackLayout Spacing="12"
                                         Padding="24,20,24,28">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsLoginMode}" Value="True">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <!-- No pharmacy warning -->
                        <Border Stroke="{StaticResource Error}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6"
                                Background="{StaticResource SurfaceBrush}"
                                BackgroundColor="{StaticResource ErrorLight}"
                                Padding="12,8"
                                IsVisible="{Binding HasNoPharmacy}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Nu este configurată nicio farmacie."
                                       TextColor="{StaticResource Error}"
                                       FontSize="12"/>
                                <Button Text="Adăugare farmacie"
                                        Command="{Binding AddPharmacyCommand}"
                                        Style="{StaticResource DangerButton}"
                                        HeightRequest="32"
                                        FontSize="12"
                                        HorizontalOptions="Start"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- First / Last name -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="PRENUME" Style="{StaticResource FieldLabel}"/>
                                <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="10,0" HeightRequest="38">
                                    <Entry Text="{Binding FirstName}" Placeholder="Prenume" BackgroundColor="Transparent" VerticalOptions="Center">
                                        <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                    </Entry>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="NUME" Style="{StaticResource FieldLabel}"/>
                                <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="10,0" HeightRequest="38">
                                    <Entry Text="{Binding LastName}" Placeholder="Nume" BackgroundColor="Transparent" VerticalOptions="Center">
                                        <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                    </Entry>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Email -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="EMAIL" Style="{StaticResource FieldLabel}"/>
                            <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="10,0" HeightRequest="38">
                                <Entry Text="{Binding Email}" Placeholder="email@farmacie.ro" Keyboard="Email" BackgroundColor="Transparent" VerticalOptions="Center">
                                    <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Phone / NCM -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="TELEFON" Style="{StaticResource FieldLabel}"/>
                                <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="10,0" HeightRequest="38">
                                    <Entry Text="{Binding Phone}" Placeholder="07xx xxx xxx" Keyboard="Telephone" BackgroundColor="Transparent" VerticalOptions="Center">
                                        <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                    </Entry>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="NCM" Style="{StaticResource FieldLabel}"/>
                                <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="10,0" HeightRequest="38">
                                    <Entry Text="{Binding Ncm}" Placeholder="NCM" BackgroundColor="Transparent" VerticalOptions="Center">
                                        <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                    </Entry>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Username / Role -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="USERNAME" Style="{StaticResource FieldLabel}"/>
                                <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="10,0" HeightRequest="38">
                                    <Entry Text="{Binding Username}" Placeholder="username" BackgroundColor="Transparent" VerticalOptions="Center">
                                        <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                    </Entry>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="ROL" Style="{StaticResource FieldLabel}"/>
                                <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="10,0" HeightRequest="38">
                                    <Picker ItemsSource="{Binding AvailableRoles}"
                                            SelectedItem="{Binding SelectedRole}"
                                            BackgroundColor="Transparent"
                                            VerticalOptions="Center"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Password / Confirm -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="PAROLĂ" Style="{StaticResource FieldLabel}"/>
                                <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="10,0" HeightRequest="38">
                                    <Entry Text="{Binding Password}" IsPassword="True" Placeholder="Minim 6 caractere" BackgroundColor="Transparent" VerticalOptions="Center">
                                        <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                    </Entry>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="CONFIRMARE PAROLĂ" Style="{StaticResource FieldLabel}"/>
                                <Border Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Background="{StaticResource SurfaceBrush}" Padding="10,0" HeightRequest="38">
                                    <Entry Text="{Binding ConfirmPassword}" IsPassword="True" Placeholder="Repetați parola" BackgroundColor="Transparent" VerticalOptions="Center">
                                        <Entry.Behaviors><helpers:FocusBorderBehavior/></Entry.Behaviors>
                                    </Entry>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Error -->
                        <Label Text="{Binding AddUserErrorMessage}"
                               TextColor="{StaticResource Error}"
                               FontSize="12"
                               IsVisible="{Binding HasAddUserError}"
                               HorizontalOptions="Center"/>

                        <!-- Submit -->
                        <Button Text="Creare cont"
                                Command="{Binding AddUserCommand}"
                                IsEnabled="{Binding IsNotAddUserLoading}"
                                HeightRequest="42"
                                Margin="0,4,0,0"/>

                        <ActivityIndicator IsRunning="{Binding IsAddUserLoading}"
                                           IsVisible="{Binding IsAddUserLoading}"
                                           Color="{StaticResource Primary}"
                                           HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Footer -->
            <Label Text="© 2025 Recomandarea Farmacistului"
                   FontSize="11"
                   TextColor="#475569"
                   HorizontalOptions="Center"
                   Margin="0,16,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
